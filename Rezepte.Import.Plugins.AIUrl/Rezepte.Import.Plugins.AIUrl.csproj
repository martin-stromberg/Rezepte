<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <!-- Microsoft.Extensions.* assemblies are framework-provided under net11.0; the explicit
         references are kept for clarity, so the NU1510 advisory is suppressed. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <ProjectReference Include="..\Rezepte.Import.Abstractions\Rezepte.Import.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RezepteWebReferencePath)' != ''">
    <Reference Include="Rezepte.Web">
      <HintPath>$(RezepteWebReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RezepteWebReferencePath)' == ''">
    <Reference Include="Rezepte.Web">
      <HintPath>..\Rezepte.Web\bin\$(Configuration)\$(TargetFramework)\Rezepte.Web.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
