<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ExternalImportPluginsPath>$(MSBuildProjectDirectory)\..\external\rezepte-import-plugins-private\artifacts\plugins</ExternalImportPluginsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Vision.V1" Version="3.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="QuestPDF" Version="2026.7.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="msTools.Updater" Version="0.10.0" />
  </ItemGroup>

  <!-- Verhindere, dass die JSON beim Publish mit kopiert wird (gilt für alle Konfigurationen) -->
  <ItemGroup>
    <Content Update="test.recipe-import.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Debug: kopiere nur ins Build-Output, nicht ins Publish-Verzeichnis -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Update="test.recipe-import.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rezepte.Import.Abstractions\Rezepte.Import.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ImportPluginProject Include="..\Rezepte.Import.Plugins.Backup\Rezepte.Import.Plugins.Backup.csproj">
      <PluginName>Rezepte.Import.Plugins.Backup</PluginName>
    </ImportPluginProject>
    <ImportPluginProject Include="..\Rezepte.Import.Plugins.AIFoto\Rezepte.Import.Plugins.AIFoto.csproj">
      <PluginName>Rezepte.Import.Plugins.AIFoto</PluginName>
    </ImportPluginProject>
    <ImportPluginProject Include="..\Rezepte.Import.Plugins.AIUrl\Rezepte.Import.Plugins.AIUrl.csproj">
      <PluginName>Rezepte.Import.Plugins.AIUrl</PluginName>
    </ImportPluginProject>
  </ItemGroup>

  <Target Name="BuildImportPlugins" BeforeTargets="CopyImportPluginsToOutput;CopyImportPluginsToPublish" Condition="'$(BuildingSolutionFile)' != 'true'">
    <MSBuild Projects="@(ImportPluginProject)" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=;SelfContained=false;RezepteWebReferencePath=$(TargetDir)Rezepte.Web.dll" />
  </Target>

  <Target Name="CopyImportPluginsToOutput" AfterTargets="Build">
    <RemoveDir Directories="$(OutputPath)plugins" />
    <ItemGroup>
      <ImportPluginOutput Include="%(ImportPluginProject.RootDir)%(ImportPluginProject.Directory)bin\$(Configuration)\$(TargetFramework)\**\*.*" Exclude="%(ImportPluginProject.RootDir)%(ImportPluginProject.Directory)bin\$(Configuration)\$(TargetFramework)\plugins\**\*.*;%(ImportPluginProject.RootDir)%(ImportPluginProject.Directory)bin\$(Configuration)\$(TargetFramework)\publish\**\*.*">
        <PluginName>%(ImportPluginProject.PluginName)</PluginName>
      </ImportPluginOutput>
      <ExternalImportPluginOutput Include="$(ExternalImportPluginsPath)\**\*.*" Condition="Exists('$(ExternalImportPluginsPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(ImportPluginOutput)" DestinationFiles="@(ImportPluginOutput->'$(OutputPath)plugins\%(PluginName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ExternalImportPluginOutput)" DestinationFiles="@(ExternalImportPluginOutput->'$(OutputPath)plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyImportPluginsToPublish" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)plugins" />
    <ItemGroup>
      <ImportPluginPublishOutput Include="%(ImportPluginProject.RootDir)%(ImportPluginProject.Directory)bin\$(Configuration)\$(TargetFramework)\**\*.*" Exclude="%(ImportPluginProject.RootDir)%(ImportPluginProject.Directory)bin\$(Configuration)\$(TargetFramework)\plugins\**\*.*;%(ImportPluginProject.RootDir)%(ImportPluginProject.Directory)bin\$(Configuration)\$(TargetFramework)\publish\**\*.*">
        <PluginName>%(ImportPluginProject.PluginName)</PluginName>
      </ImportPluginPublishOutput>
      <ExternalImportPluginPublishOutput Include="$(ExternalImportPluginsPath)\**\*.*" Condition="Exists('$(ExternalImportPluginsPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(ImportPluginPublishOutput)" DestinationFiles="@(ImportPluginPublishOutput->'$(PublishDir)plugins\%(PluginName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ExternalImportPluginPublishOutput)" DestinationFiles="@(ExternalImportPluginPublishOutput->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
