@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-semibold d-flex align-items-center gap-2" href="/">
            <img src="icons/rezepte_64x64.ico" alt="Rezepte" width="24" height="24" class="me-1" />
            <span>Rezepte</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link d-flex align-items-center" href="/cookbooks" title="Kochbücher">
                        <span class="me-1">📚</span>
                        <span class="d-inline">Kochbücher</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link d-flex align-items-center" href="/calendar" title="Kalender">
                        <span class="me-1">📅</span>
                        <span class="d-inline">Kalender</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link d-flex align-items-center" href="/shopping-list" title="Einkaufsliste">
                        <span class="bi bi-cart-check me-1" aria-hidden="true"></span>
                        <span class="d-inline">Einkaufsliste</span>
                    </NavLink>
                </li>
            </ul>

            <!-- Search box in title bar -->
            <form class="nav-search-form d-flex w-100 my-2 my-lg-0 ms-lg-3 me-lg-2" role="search" @onsubmit="OnSubmitSearch" action="recipes/search">
                <InputText id="nav-search" name="q" class="form-control form-control-sm" placeholder="Rezepte suchen..." aria-label="Suche Rezepte" @bind-Value="searchQuery" @bind-Value:event="oninput" />
                <button type="submit" class="btn btn-sm btn-outline-light ms-2" aria-label="Suche starten">🔍</button>
            </form>

            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center nav-actions">
                <AuthorizeView>
                    <Authorized>
                        @{
                            var userName = context.User.Identity?.Name ?? "Angemeldeter Benutzer";
                            var userId = context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                            var roleName = context.User.IsInRole("Admin") ? "Admin" : "Benutzer";
                        }
                        <li class="nav-item">
                            <NavLink class="nav-link nav-icon-link" href="/settings" title="Einrichtung" aria-label="Einrichtung">
                                <span class="bi bi-gear-fill" aria-hidden="true"></span>
                                <span class="nav-mobile-label">Einrichtung</span>
                            </NavLink>
                        </li>
                        <li class="nav-item dropdown">
                            <button type="button" class="nav-link nav-user-button dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Benutzermenü öffnen">
                                <span class="bi bi-person-circle" aria-hidden="true"></span>
                                <span class="nav-mobile-label">Benutzermenü</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end user-dropdown">
                                <div class="dropdown-header user-dropdown-header">
                                    <div class="user-dropdown-name">@userName</div>
                                    <div class="user-dropdown-role">@roleName</div>
                                    @if (!string.IsNullOrWhiteSpace(userId))
                                    {
                                        <div class="user-dropdown-id">ID: @userId</div>
                                    }
                                </div>
                                <div class="dropdown-divider"></div>
                                <form action="api/session/logout?returnUrl=/login" method="post" formname="logout">
                                    <button type="submit" class="dropdown-item">Abmelden</button>
                                </form>
                            </div>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/login">Anmelden</NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

<LoadingBar />

<main class="container py-4">
    @Body
</main>

<footer class="app-footer text-center py-4 mt-auto">
    <div class="container small text-muted">
        © @DateTime.Now.Year Rezepte · Mit Liebe gekocht · Version @ApplicationVersion.Current
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" onclick="this.closest('#blazor-error-ui').style.display='none'">🗙</span>
</div>

@code {
    private string searchQuery = string.Empty;

    private Task OnSubmitSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            Nav.NavigateTo("/recipes");
        }
        else
        {
            var q = Uri.EscapeDataString(searchQuery.Trim());
            Nav.NavigateTo($"/recipes/search?q={q}");
        }

        return Task.CompletedTask;
    }
}
