@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject ApiClient Api
@inject ILogger<Rezepte.Web.Components.Shared.RecipeSelectDialog> Logger
@inject IStringLocalizer<UiStrings> Localizer

<div class="modal fade show" style="display:block; background: rgba(0,0,0,.5);" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["AddExistingRecipes"]</h5>
                <button type="button" class="btn-close" aria-label="@Localizer["Close"]" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input class="form-control" placeholder="@Localizer["SearchPlaceholder"]" @bind="search" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
                </div>
                @if (isLoading)
                {
                    <div class="text-muted">Lade…</div>
                }
                else if (loadError)
                {
                    <div class="alert alert-danger">@Localizer["RecipesLoadFailed"]</div>
                }
                else if (items.Count == 0 && !isLoading)
                {
                    <div class="alert alert-info">@Localizer["NoMoreRecipesAvailable"]</div>
                }
                else
                {
                    <div style="max-height: 400px; overflow-y: auto;">
                        @foreach (var item in items)
                        {
                            <label class="list-group-item d-flex align-items-center gap-2">
                                <input type="checkbox" class="form-check-input me-2" @bind="item.Selected" />
                                <div>
                                    <div class="fw-semibold">@item.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="text-muted small">@item.Description</div>
                                    }
                                </div>
                            </label>
                        }
                        @if (hasMore && !isLoadingMore)
                        {
                            <div class="text-center my-2">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadMore">@Localizer["LoadMore"]</button>
                            </div>
                        }
                        @if (isLoadingMore)
                        {
                            <div class="text-center my-2 text-muted">@Localizer["LoadingMore"]</div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">Abbrechen</button>
                <button type="button" class="btn btn-primary" @onclick="Confirm" disabled="@(!items.Any(a => a.Selected))">Hinzufügen</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string CookbookId { get; set; } = string.Empty;
    [Parameter] public EventCallback<List<RecipeListItem>> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string search = string.Empty;
    private bool isLoading;
    private bool isLoadingMore;
    private bool loadError;
    private List<RecipeListItem> items = new();
    private int page = 1;
    private bool hasMore = true;
    private const int PageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(reset: true);
    }

    private async Task LoadAsync(bool reset)
    {
        if (reset)
        {
            page = 1;
            items.Clear();
            hasMore = true;
        }
        isLoading = reset;
        isLoadingMore = !reset;
        loadError = false;
        try
        {
            var url = $"api/recipes/available-for/{CookbookId}?page={page}&pageSize={PageSize}&search={Uri.EscapeDataString(search ?? "")}";
            var result = await Api.Http.GetFromJsonAsync<List<RecipeListItem>>(url) ?? new();
            if (reset)
            {
                items = result;
            }
            else
            {
                items.AddRange(result);
            }
            hasMore = result.Count == PageSize;
            page++;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the selectable recipes of cookbook {CookbookId} failed", CookbookId);
            loadError = true;
        }
        finally { isLoading = false; isLoadingMore = false; StateHasChanged(); }
    }

    private async Task LoadMore()
    {
        await LoadAsync(reset: false);
    }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync(items.Where(i => i.Selected).ToList());
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadAsync(reset: true);
        }
    }

    public class RecipeListItem
    {
        public string Id { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool Selected { get; set; }
    }
}
