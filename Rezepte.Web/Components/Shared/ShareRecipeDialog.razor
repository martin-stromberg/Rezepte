@using Microsoft.JSInterop
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<Rezepte.Web.Components.Shared.ShareRecipeDialog> Logger
@inject IStringLocalizer<UiStrings> Localizer

@if (Show)
{
    <div class="overlay-backdrop" @onclick="OnClose">
        <div class="overlay-content" @onclick:stopPropagation>
            <button class="btn btn-sm btn-danger overlay-close" @onclick="OnCancelClick">×</button>
            <h5>@Localizer["ShareDialogTitle"]</h5>
            <p class="text-muted">@Localizer["ShareDialogDescription"]</p>

            @if (shareUrl is null)
            {
                @if (HasSideDishes)
                {
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="share-include-sidedishes" @bind="includeSideDishes" disabled="@isBusy" />
                        <label class="form-check-label" for="share-include-sidedishes">@Localizer["ShareIncludeSideDishes"]</label>
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2">@errorMessage</div>
                }

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="CreateLinkAsync" disabled="@isBusy">@Localizer["ShareCreateLink"]</button>
                    <button class="btn btn-outline-secondary" @onclick="OnCancelClick" disabled="@isBusy">@Localizer["Cancel"]</button>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <input class="form-control" type="text" id="share-link-url" value="@shareUrl" readonly />
                    <div class="form-text">@Localizer["ShareLinkValidUntil"]: @expiresAt?.ToLocalTime().ToString("d")</div>
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="mb-2 text-muted">@message</div>
                }

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="CopyAsync">@Localizer["ShareCopy"]</button>
                    <button class="btn btn-outline-secondary" @onclick="OnCancelClick">@Localizer["Close"]</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string RecipeId { get; set; } = string.Empty;
    [Parameter] public bool HasSideDishes { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool wasShown;
    private bool includeSideDishes;
    private bool isBusy;
    private string? shareUrl;
    private DateTime? expiresAt;
    private string? message;
    private string? errorMessage;

    protected override void OnParametersSet()
    {
        if (Show && !wasShown)
        {
            includeSideDishes = false;
            isBusy = false;
            shareUrl = null;
            expiresAt = null;
            message = null;
            errorMessage = null;
        }
        wasShown = Show;
    }

    private async Task CreateLinkAsync()
    {
        isBusy = true;
        errorMessage = null;
        try
        {
            var response = await Api.Http.PostAsJsonAsync($"api/recipes/{RecipeId}/share", new { includeSideDishes });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ShareLinkResponse>();
                if (result is not null)
                {
                    expiresAt = result.ExpiresAt;
                    shareUrl = Nav.ToAbsoluteUri($"share/{result.Token}").ToString();
                }
                else
                {
                    errorMessage = Localizer["ShareCreateFailed"];
                }
            }
            else
            {
                errorMessage = Localizer["ShareCreateFailed"];
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = Localizer["ShareCreateFailed"];
        }
        catch (TaskCanceledException)
        {
            errorMessage = Localizer["ShareCreateFailed"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Creating the share link for recipe {RecipeId} failed", RecipeId);
            errorMessage = Localizer["ShareCreateFailed"];
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task CopyAsync()
    {
        try
        {
            var copied = await JS.InvokeAsync<bool>("rezepteCopyToClipboard", shareUrl);
            message = copied ? Localizer["ShareCopied"] : Localizer["ShareCopyFailed"];
        }
        catch (JSException)
        {
            message = Localizer["ShareCopyFailed"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Copying the share link for recipe {RecipeId} to the clipboard failed", RecipeId);
            message = Localizer["ShareCopyFailed"];
        }
    }

    private async Task OnCancelClick()
    {
        await OnClose.InvokeAsync();
    }

    private record ShareLinkResponse(string Token, DateTime ExpiresAt);
}
