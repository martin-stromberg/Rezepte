@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Rezepte.Web.Services
@inject IShoppingListService ShoppingListService
@inject AuthenticationStateProvider AuthStateProvider

@if (Show)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="shoppingListDialogTitle">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="shoppingListDialogTitle" class="modal-title">Zutaten übernehmen</h5>
                    <button type="button" class="btn-close" aria-label="Schließen" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success") py-2">@message</div>
                    }

                    @if (isLoading)
                    {
                        <div class="text-muted">Lade Zutaten...</div>
                    }
                    else if (ingredientGroups.Sum(g => g.Ingredients.Count) == 0)
                    {
                        <div class="alert alert-info mb-0">Dieses Rezept hat keine Zutaten.</div>
                    }
                    else
                    {
                        @foreach (var group in ingredientGroups)
                        {
                            <div class="d-flex align-items-center justify-content-between gap-3 mb-2 mt-@(group.IsMainRecipe ? "0" : "3")">
                                <div class="small text-muted">
                                    Gruppe: @group.RecipeTitle@(group.IsMainRecipe ? string.Empty : " (Beilage)")
                                </div>
                                @if (group.Ingredients.Count > 0)
                                {
                                    <label class="form-check form-check-inline small mb-0">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               checked="@AreAllGroupIngredientsSelected(group)"
                                               @onchange="e => ToggleIngredientGroup(group, e.Value is bool checkedValue && checkedValue)" />
                                        <span class="form-check-label">Alle</span>
                                    </label>
                                }
                            </div>
                            <div class="list-group">
                                @foreach (var ingredient in group.Ingredients)
                                {
                                    <label class="list-group-item d-flex align-items-start gap-2">
                                        <input class="form-check-input mt-1"
                                               type="checkbox"
                                               checked="@selectedIngredientIds.Contains(ingredient.Id)"
                                               @onchange="e => ToggleIngredient(ingredient.Id, e.Value is bool checkedValue && checkedValue)" />
                                        <span>
                                            <span class="d-block">@FormatIngredient(ingredient)</span>
                                            @if (!string.IsNullOrWhiteSpace(ingredient.StepTitle))
                                            {
                                                <span class="small text-muted">@ingredient.StepTitle</span>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                        @if (ingredientGroups.Any(g => !g.IsMainRecipe))
                        {
                            <div class="form-text mt-2">Zutaten der Beilagen sind nicht vorausgewählt.</div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Abbrechen</button>
                    <button type="button" class="btn btn-success" disabled="@(isLoading || selectedIngredientIds.Count == 0)" @onclick="AddAsync">
                        <span class="bi bi-cart-plus" aria-hidden="true"></span>
                        <span class="ms-1">Übernehmen</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string RecipeId { get; set; } = string.Empty;
    [Parameter] public string RecipeTitle { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }

    private readonly HashSet<string> selectedIngredientIds = new();
    private List<ShoppingListRecipeIngredientGroup> ingredientGroups = new();
    private bool isLoading;
    private bool wasShown;
    private string? userId;
    private string? message;
    private bool isError;

    protected override async Task OnParametersSetAsync()
    {
        if (Show && (!wasShown || ingredientGroups.Count == 0))
        {
            wasShown = true;
            await LoadAsync();
        }
        else if (!Show)
        {
            wasShown = false;
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        message = null;
        selectedIngredientIds.Clear();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        ingredientGroups = string.IsNullOrWhiteSpace(userId)
            ? new List<ShoppingListRecipeIngredientGroup>()
            : await ShoppingListService.GetRecipeIngredientGroupsAsync(userId, RecipeId, CancellationToken.None);

        foreach (var ingredient in ingredientGroups.Where(g => g.IsMainRecipe).SelectMany(g => g.Ingredients))
        {
            selectedIngredientIds.Add(ingredient.Id);
        }

        isLoading = false;
    }

    private void ToggleIngredient(string ingredientId, bool isSelected)
    {
        if (isSelected)
        {
            selectedIngredientIds.Add(ingredientId);
        }
        else
        {
            selectedIngredientIds.Remove(ingredientId);
        }
    }

    private bool AreAllGroupIngredientsSelected(ShoppingListRecipeIngredientGroup group)
    {
        return group.Ingredients.Count > 0
            && group.Ingredients.All(ingredient => selectedIngredientIds.Contains(ingredient.Id));
    }

    private void ToggleIngredientGroup(ShoppingListRecipeIngredientGroup group, bool isSelected)
    {
        foreach (var ingredient in group.Ingredients)
        {
            ToggleIngredient(ingredient.Id, isSelected);
        }
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var selections = ingredientGroups
            .Select(g => new ShoppingListRecipeIngredientSelection(
                g.RecipeId,
                g.Ingredients.Where(i => selectedIngredientIds.Contains(i.Id)).Select(i => i.Id).ToList()))
            .Where(s => s.IngredientIds.Count > 0)
            .ToList();
        var result = await ShoppingListService.AddRecipeIngredientGroupsAsync(userId, RecipeId, selections, CancellationToken.None);
        if (!result.ok)
        {
            isError = true;
            message = result.error;
            return;
        }

        await OnAdded.InvokeAsync();
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        await OnClose.InvokeAsync();
    }

    private static string FormatIngredient(ShoppingListRecipeIngredient ingredient)
    {
        var amount = ingredient.Amount == 0 ? string.Empty : ingredient.Amount.ToString("0.##");
        return string.Join(" ", new[] { amount, ingredient.Unit, ingredient.Name }.Where(v => !string.IsNullOrWhiteSpace(v)));
    }
}
