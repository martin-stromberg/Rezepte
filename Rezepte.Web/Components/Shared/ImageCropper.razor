@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject Rezepte.Web.Services.ITokenService TokenService
@inject ILogger<Rezepte.Web.Components.Shared.ImageCropper> Logger
@inject IStringLocalizer<UiStrings> Localizer
@rendermode InteractiveServer

@if (Show)
{
    <div class="image-cropper-backdrop" @onclick="() => { }">
        <div class="image-cropper-content" @onclick:stopPropagation style="max-width:900px; width:100%; max-height:90vh;">
            <button class="btn btn-sm btn-danger overlay-close" @onclick="Cancel" disabled="@isUploading">×</button>

            <div class="text-center mb-2 position-relative">
                <img id="@ImgId" src="@ImageDataUrl" style="max-width:100%; max-height:70vh; display:block; margin:0 auto;" />

                @if (!_initialized)
                {
                    <div class="overlay-loading d-flex align-items-center justify-content-center">
                        <div class="spinner-border" role="status" aria-hidden="true"></div>
                        <div class="ms-2">@Localizer["LoadingPreview"]</div>
                    </div>
                }

                @if (isUploading)
                {
                    <div class="overlay-loading d-flex align-items-center justify-content-center">
                        <div class="spinner-border" role="status" aria-hidden="true"></div>
                        <div class="ms-2">@Localizer["SavingImage"]</div>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="Cancel" disabled="@isUploading">Abbrechen</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(!_initialized || isUploading)">@Localizer["CropAndSave"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string? ImageDataUrl { get; set; }
    [Parameter] public string? UploadUrl { get; set; }
    [Parameter] public EventCallback<bool> OnUploaded { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string ImgId = "cropperImg_" + Guid.NewGuid().ToString("n");
    private bool _initialized;
    private string? _lastImageDataUrl;
    private bool isUploading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && !string.IsNullOrEmpty(ImageDataUrl))
        {
            if (!_initialized || _lastImageDataUrl != ImageDataUrl)
            {
                try
                {
                    var ok = await JS.InvokeAsync<bool>("imageCropper.init", ImgId, ImageDataUrl);
                    _initialized = ok;
                    _lastImageDataUrl = ImageDataUrl;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Could not initialize the image cropper for {ImageElementId}", ImgId);
                    _initialized = false;
                }
                StateHasChanged();
            }
        }
        else if (!Show && _initialized)
        {
            try
            {
                await JS.InvokeVoidAsync("imageCropper.destroy", ImgId);
            }
            catch (JSDisconnectedException)
            {
                // circuit is already gone; nothing left to clean up on the client
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not destroy the image cropper for {ImageElementId}", ImgId);
            }
            _initialized = false;
            _lastImageDataUrl = null;
        }
    }

    private async Task SaveAsync()
    {
        if (!_initialized || string.IsNullOrEmpty(UploadUrl))
        {
            await OnUploaded.InvokeAsync(false);
            return;
        }

        isUploading = true;
        StateHasChanged();

        string? token = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
                var userName = user.Identity?.Name ?? user.FindFirst(ClaimTypes.Name)?.Value ?? userId;
                var isAdmin = user.IsInRole("Admin");

                if (!string.IsNullOrEmpty(userId))
                {
                    token = TokenService.GetToken(userId);
                    if (string.IsNullOrEmpty(token))
                    {
                        // CreateToken caches token in TokenService
                        token = TokenService.CreateToken(userId, userName ?? userId, isAdmin);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not create an upload token from the current authentication state");
            token = null;
        }

        // fallback: try client storage only if server token not available
        if (string.IsNullOrEmpty(token))
        {
            try
            {
                token = await JS.InvokeAsync<string>("localStorage.getItem", "access_token");
                if (string.IsNullOrEmpty(token))
                    token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
                if (string.IsNullOrEmpty(token))
                    token = await JS.InvokeAsync<string>("sessionStorage.getItem", "access_token");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not read an upload token from client storage");
                token = null;
            }
        }

        var result = await JS.InvokeAsync<object>("imageCropper.uploadCroppedBlob", ImgId, UploadUrl, "photo.jpg", token, 0.9, 1600, 1600, 15000);

        bool ok = false;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(result);
            var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("ok", out var p) && p.GetBoolean())
                ok = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not interpret the upload result of the image cropper");
            ok = false;
        }

        isUploading = false;
        StateHasChanged();

        await OnUploaded.InvokeAsync(ok);
    }

    private async Task Cancel()
    {
        if (isUploading) return;
        await OnCancel.InvokeAsync();
    }
}