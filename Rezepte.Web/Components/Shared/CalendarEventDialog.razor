@namespace Rezepte.Web.Components.Shared
@using System.Net.Http.Json
@using Rezepte.Web.Entities
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Client

@* Render content: modal (zentriert) oder inline *@
@if (Modal)
{
    <div class="calendar-dialog-backdrop" @onclick="Cancel">
        <div class="calendar-dialog-container" @onclick:stopPropagation>
            <div class="card mt-0 p-3">
                @* Card content (form) *@
                <h5>@(EditingId == null ? "Neuer Termin" : "Termin bearbeiten")</h5>

                <div class="mb-2">
                    <label class="form-label">Rezept (optional)</label>
                    @if (!string.IsNullOrWhiteSpace(selectedRecipeTitle))
                    {
                        <div class="card mb-2" style="cursor:default;">
                            <div class="row g-0 align-items-center">
                                <div class="col-auto">
                                    @if (!string.IsNullOrWhiteSpace(selectedRecipeImageUrl))
                                    {
                                        <img src="@selectedRecipeImageUrl" class="img-fluid" style="width:96px;height:96px;object-fit:cover;" alt="@selectedRecipeTitle" />
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center" style="width:96px;height:96px;">Bild</div>
                                    }
                                </div>
                                <div class="col px-3">
                                    <div class="fw-semibold">@selectedRecipeTitle</div>
                                    @if (!string.IsNullOrWhiteSpace(selectedRecipeSnippet))
                                    {
                                        <div class="text-muted small">@selectedRecipeSnippet</div>
                                    }
                                </div>
                                <div class="col-auto pe-2">
                                    <button type="button" class="btn btn-outline-secondary" @onclick="ShowRecipePickerAsync">Ändern</button>
                                    <button type="button" class="btn btn-outline-danger ms-1" @onclick="RemoveSelectedRecipe">Entfernen</button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card mb-2" style="cursor:pointer;" @onclick="ShowRecipePickerAsync">
                            <div class="card-body text-center text-muted">
                                <div class="fw-semibold">Kein Rezept ausgewählt</div>
                                <div class="small">Klicken, um ein Rezept auszuwählen</div>
                            </div>
                        </div>
                    }

                    <div class="input-group visually-hidden">
                        <input class="form-control" @bind="form.RecipeId" placeholder="Rezept‑Id oder per Auswahl wählen" />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label">Datum</label>
                    <input type="date" class="form-control" @bind="form.StartDate" />
                </div>

                <div class="mb-2">
                    <label class="form-label">Tageszeit</label>
                    <InputRadioGroup class="d-flex gap-2" @bind-Value="form.Period">
                        <div class="form-check">
                            <InputRadio class="form-check-input" Value="AppointmentPeriod.Morning" />
                            <label class="form-check-label">Morgens</label>
                        </div>
                        <div class="form-check">
                            <InputRadio class="form-check-input" Value="AppointmentPeriod.Noon" />
                            <label class="form-check-label">Mittags</label>
                        </div>
                        <div class="form-check">
                            <InputRadio class="form-check-input" Value="AppointmentPeriod.Evening" />
                            <label class="form-check-label">Abends</label>
                        </div>
                        <div class="form-check">
                            <InputRadio class="form-check-input" Value="AppointmentPeriod.Night" />
                            <label class="form-check-label">Nachts</label>
                        </div>
                    </InputRadioGroup>
                </div>

                <div class="mb-2">
                    <label class="form-label">Portionen</label>
                    <input type="number" min="1" class="form-control" @bind="form.Portions" />
                </div>

                @if (EditingId == null && sideDishSuggestions.Count > 0)
                {
                    <div class="mb-2">
                        <label class="form-label">Beilagen</label>
                        <div class="list-group">
                            @foreach (var sideDish in sideDishSuggestions)
                            {
                                <label class="list-group-item d-flex align-items-center gap-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@selectedSideDishIds.Contains(sideDish.Id)"
                                           @onchange="e => ToggleSideDish(sideDish.Id, e.Value is bool checkedValue && checkedValue)" />
                                    <span>@sideDish.Title</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(submitError))
                {
                    <div class="alert alert-danger py-2">@submitError</div>
                }

                <div class="mb-2">
                    <label class="form-label">Wöchentlich an</label>
                    <div>
                        @foreach (var wd in Enum.GetValues(typeof(WeekDays)).Cast<WeekDays>().Where(w => w != WeekDays.None))
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" @bind="bindWeekDays[wd]" />
                                <label class="form-check-label">@wd</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary" @onclick="SubmitForm">Speichern</button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">Abbrechen</button>
                </div>

                @* picker markup included below to overlay above modal card *@
            </div>
        </div>
    </div>
}
else
{
    <div class="card mt-3 p-3">
        <h5>@(EditingId == null ? "Neuer Termin" : "Termin bearbeiten")</h5>

        @* Inline: reuse same form content (kept minimal here) *@
        <div class="mb-2">
            <label class="form-label">Rezept (optional)</label>
            @if (!string.IsNullOrWhiteSpace(selectedRecipeTitle))
            {
                <div class="small text-muted mb-2">Ausgewählt: @selectedRecipeTitle</div>
            }
            else
            {
                <div class="small text-muted mb-2">Kein Rezept ausgewählt</div>
            }
            <div class="input-group visually-hidden">
                <input class="form-control" @bind="form.RecipeId" />
            </div>
        </div>

        <div class="mb-2">
            <label class="form-label">Datum</label>
            <input type="date" class="form-control" @bind="form.StartDate" />
        </div>

        <div class="mb-2">
            <label class="form-label">Tageszeit</label>
            <InputRadioGroup class="d-flex gap-2" @bind-Value="form.Period">
                <div class="form-check">
                    <InputRadio class="form-check-input" Value="AppointmentPeriod.Morning" />
                    <label class="form-check-label">Morgens</label>
                </div>
                <div class="form-check">
                    <InputRadio class="form-check-input" Value="AppointmentPeriod.Noon" />
                    <label class="form-check-label">Mittags</label>
                </div>
                <div class="form-check">
                    <InputRadio class="form-check-input" Value="AppointmentPeriod.Evening" />
                    <label class="form-check-label">Abends</label>
                </div>
                <div class="form-check">
                    <InputRadio class="form-check-input" Value="AppointmentPeriod.Night" />
                    <label class="form-check-label">Nachts</label>
                </div>
            </InputRadioGroup>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" @onclick="SubmitForm">Speichern</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Abbrechen</button>
        </div>
    </div>
}

@* Recipe picker modal (shared for both modes) *@
@if (showRecipePicker)
{
    <div class="modal-backdrop" style="position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:13000;background:rgba(0,0,0,.45);" @onclick="CloseRecipePicker">
        <div class="card p-3" style="max-width:720px;width:95%;" @onclick:stopPropagation>
            <div class="d-flex mb-2">
                <input class="form-control me-2" placeholder="Rezept suchen..." @bind="recipeSearchQuery" @oninput="OnRecipeSearchInput" @ref="recipeSearchInputRef" />
                <button type="button" class="btn btn-outline-secondary" @onclick="TriggerRecipeSearchAsync">Suchen</button>
            </div>

            @if (isSearching)
            {
                <div class="mb-2">suche…</div>
            }

            @if (recipeResults?.Any() == true)
            {
                <div class="list-group mb-2" style="max-height:360px;overflow:auto;">
                    @foreach (var r in recipeResults)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-3 align-items-center">
                                @if (!string.IsNullOrWhiteSpace(r.PrimaryImageUrl))
                                {
                                    <img src="@r.PrimaryImageUrl" style="width:64px;height:64px;object-fit:cover;" alt="@r.Title" />
                                }
                                <div>
                                    <div class="fw-semibold">@r.Title</div>
                                    @if (!string.IsNullOrEmpty(r.Snippet))
                                    {
                                        <div class="small text-muted">@r.Snippet</div>
                                    }
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectRecipe(r)">Wählen</button>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (!isSearching && !string.IsNullOrWhiteSpace(recipeSearchQuery))
            {
                <div class="text-muted">Keine Treffer.</div>
            }

            <div class="d-flex justify-content-end gap-2 mt-2">
                <button type="button" class="btn btn-secondary" @onclick="CloseRecipePicker">Schließen</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? EditingId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // Neues Parameterobjekt: InitialEvent wird vom Parent gesetzt, wenn editieren
    [Parameter] public Rezepte.Web.Models.CalendarEventDto? InitialEvent { get; set; }

    // Wenn true, zeigt die Komponente sich als zentriertes Overlay
    [Parameter] public bool Modal { get; set; } = false;

    private FormModel form = new();
    private Dictionary<WeekDays, bool> bindWeekDays = Enum.GetValues(typeof(WeekDays)).Cast<WeekDays>().Where(w => w != WeekDays.None).ToDictionary(w => (WeekDays)w, _ => false);

    // recipe picker state
    private bool showRecipePicker;
    private string recipeSearchQuery = string.Empty;
    private List<RecipeSearchResultDto>? recipeResults;
    private bool isSearching;
    private CancellationTokenSource? recipeSearchCts;
    private ElementReference recipeSearchInputRef;

    // selected recipe preview
    private string? selectedRecipeTitle;
    private string? selectedRecipeSnippet;
    private string? selectedRecipeImageUrl;
    private string? submitError;
    private List<RecipeSideDishDto> sideDishSuggestions = new();
    private HashSet<string> selectedSideDishIds = new();
    private bool mainCalendarEventCreated;
    private HashSet<string> createdSideDishIds = new();

    // DTOs / local types
    private record RecipeSearchResultDto(string Id, string Title, string? Snippet, string? PrimaryImageUrl, int? DefaultPortions);
    private record RecipeSearchResponseDto(RecipeSearchResultDto[] Items, int Total);
    private record RecipeSideDishDto(string Id, string Title, string? Description, string? ImageUrl, int Portions);

    private record CreateDto(string? RecipeId, DateTime StartDate, TimeSpan TimeOfDay, Int32 Portions, RecurrenceType Recurrence, WeekDays RecurrenceDays);
    private record UpdateDto(DateTime StartDate, TimeSpan TimeOfDay, Int32 Portions, RecurrenceType Recurrence, WeekDays RecurrenceDays);

    private enum AppointmentPeriod { Morning, Noon, Evening, Night }

    // minimaler Preview-Typ für Recipe GET
    private record RecipePreviewDto(string Id, string Title, string? Description, string? ImageUrl);

    protected override async Task OnParametersSetAsync()
    {
        // Wenn InitialEvent gesetzt ist -> lade Werte in Form
        if (InitialEvent != null)
        {
            form.RecipeId = InitialEvent.RecipeId;
            form.StartDate = InitialEvent.StartDate;
            form.TimeOfDay = InitialEvent.TimeOfDay;
            form.Portions = InitialEvent.Portions;
            form.Recurrence = InitialEvent.Recurrence;
            form.RecurrenceDays = InitialEvent.RecurrenceDays;
            form.Period = MapTimeSpanToPeriod(form.TimeOfDay);

            // bindWeekDays aus RecurrenceDays setzen
            foreach (var k in bindWeekDays.Keys.ToList())
            {
                bindWeekDays[k] = (form.RecurrenceDays & k) != 0;
            }

            // Falls Rezept vorhanden: lade Preview (try/catch tolerant)
            selectedRecipeTitle = null;
            selectedRecipeSnippet = null;
            selectedRecipeImageUrl = null;
            if (!string.IsNullOrWhiteSpace(form.RecipeId))
            {
                try
                {
                    var dto = await Client.Http.GetFromJsonAsync<RecipePreviewDto>($"/api/recipes/{form.RecipeId}");
                    if (dto != null)
                    {
                        selectedRecipeTitle = dto.Title;
                        selectedRecipeSnippet = dto.Description;
                        selectedRecipeImageUrl = dto.ImageUrl;
                        if (EditingId == null)
                        {
                            await LoadSideDishSuggestionsAsync(form.RecipeId);
                        }
                    }
                }
                catch
                {
                    // ignore preview load errors
                }
            }
        }
        else
        {
            // Neu: Standardwerte zurücksetzen
            form = new FormModel();
            foreach (var k in bindWeekDays.Keys.ToList()) bindWeekDays[k] = false;
            selectedRecipeTitle = null;
            selectedRecipeSnippet = null;
            selectedRecipeImageUrl = null;
            sideDishSuggestions.Clear();
            selectedSideDishIds.Clear();
            createdSideDishIds.Clear();
            mainCalendarEventCreated = false;
            submitError = null;
        }

        await base.OnParametersSetAsync();
    }

    private void Cancel()
    {
        _ = OnCancel.InvokeAsync();
    }

    private async Task SubmitForm()
    {
        submitError = null;
        form.RecurrenceDays = bindWeekDays.Where(p => p.Value).Select(p => p.Key).Aggregate(WeekDays.None, (acc, d) => acc | d);

        // Map selected period to a representative TimeSpan before sending to API
        form.TimeOfDay = MapPeriodToTimeSpan(form.Period);

        try
        {
            if (EditingId == null)
            {
                if (!mainCalendarEventCreated)
                {
                    var dto = new CreateDto(form.RecipeId, form.StartDate, form.TimeOfDay, form.Portions, form.Recurrence, form.RecurrenceDays);
                    var resp = await Client.Http.PostAsJsonAsync("/api/calendar", dto);
                    resp.EnsureSuccessStatusCode();
                    mainCalendarEventCreated = true;
                }

                foreach (var sideDishId in selectedSideDishIds.Where(id => !createdSideDishIds.Contains(id)).ToList())
                {
                    var sideDishDto = new CreateDto(sideDishId, form.StartDate, form.TimeOfDay, form.Portions, form.Recurrence, form.RecurrenceDays);
                    var sideDishResp = await Client.Http.PostAsJsonAsync("/api/calendar", sideDishDto);
                    sideDishResp.EnsureSuccessStatusCode();
                    createdSideDishIds.Add(sideDishId);
                }
            }
            else
            {
                var dto = new UpdateDto(form.StartDate, form.TimeOfDay, form.Portions, form.Recurrence, form.RecurrenceDays);
                var resp = await Client.Http.PutAsJsonAsync($"/api/calendar/{EditingId}", dto);
                resp.EnsureSuccessStatusCode();
            }

            await OnSaved.InvokeAsync();
        }
        catch
        {
            submitError = mainCalendarEventCreated
                ? "Der Haupttermin wurde gespeichert. Nicht alle Beilagen konnten hinzugefügt werden; erneutes Speichern versucht nur die fehlenden Beilagen."
                : "Termin konnte nicht gespeichert werden.";
        }
    }

    private TimeSpan MapPeriodToTimeSpan(AppointmentPeriod p) =>
        p switch
        {
            AppointmentPeriod.Morning => new TimeSpan(8, 0, 0),
            AppointmentPeriod.Noon => new TimeSpan(12, 0, 0),
            AppointmentPeriod.Evening => new TimeSpan(18, 0, 0),
            AppointmentPeriod.Night => new TimeSpan(22, 0, 0),
            _ => new TimeSpan(8, 0, 0)
        };

    private AppointmentPeriod MapTimeSpanToPeriod(TimeSpan ts)
    {
        var hour = ts.Hours;
        if (hour >= 5 && hour < 11) return AppointmentPeriod.Morning;
        if (hour >= 11 && hour < 15) return AppointmentPeriod.Noon;
        if (hour >= 15 && hour < 21) return AppointmentPeriod.Evening;
        return AppointmentPeriod.Night;
    }

    private Task ShowRecipePickerAsync()
    {
        showRecipePicker = true;
        recipeSearchQuery = string.Empty;
        recipeResults = null;
        StateHasChanged();

        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            try { await recipeSearchInputRef.FocusAsync(); } catch { }
        });

        return Task.CompletedTask;
    }

    private void CloseRecipePicker()
    {
        showRecipePicker = false;
        recipeSearchQuery = string.Empty;
        recipeResults = null;
    }

    private void OnRecipeSearchInput(ChangeEventArgs e)
    {
        recipeSearchCts?.Cancel();
        recipeSearchCts = new CancellationTokenSource();
        var ct = recipeSearchCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(350, ct);
                if (ct.IsCancellationRequested) return;
                await TriggerRecipeSearchAsync();
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task TriggerRecipeSearchAsync()
    {
        var q = recipeSearchQuery?.Trim();
        if (string.IsNullOrWhiteSpace(q))
        {
            recipeResults = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        isSearching = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var url = $"/api/recipes/search?q={Uri.EscapeDataString(q)}&page=1&pageSize=12";
            RecipeSearchResponseDto? resp = null;
            try
            {
                resp = await Client.Http.GetFromJsonAsync<RecipeSearchResponseDto>(url);
            }
            catch
            {
                try
                {
                    var list = await Client.Http.GetFromJsonAsync<List<RecipeSearchResultDto>>(url);
                    recipeResults = list ?? new List<RecipeSearchResultDto>();
                    return;
                }
                catch
                {
                    recipeResults = new List<RecipeSearchResultDto>();
                    return;
                }
            }

            recipeResults = resp?.Items?.ToList() ?? new List<RecipeSearchResultDto>();
        }
        catch
        {
            recipeResults = new List<RecipeSearchResultDto>();
        }
        finally
        {
            isSearching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectRecipe(RecipeSearchResultDto r)
    {
        form.RecipeId = r.Id;
        mainCalendarEventCreated = false;
        createdSideDishIds.Clear();
        selectedRecipeTitle = r.Title;
        selectedRecipeSnippet = r.Snippet;
        selectedRecipeImageUrl = r.PrimaryImageUrl;
        if (r.DefaultPortions.HasValue && (form.Portions <= 1 || form.Portions == r.DefaultPortions.GetValueOrDefault()))
        {
            form.Portions = r.DefaultPortions.Value;
        }
        await LoadSideDishSuggestionsAsync(r.Id);
        showRecipePicker = false;
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveSelectedRecipe()
    {
        form.RecipeId = null;
        mainCalendarEventCreated = false;
        createdSideDishIds.Clear();
        selectedRecipeTitle = null;
        selectedRecipeSnippet = null;
        selectedRecipeImageUrl = null;
        sideDishSuggestions.Clear();
        selectedSideDishIds.Clear();
    }

    private async Task LoadSideDishSuggestionsAsync(string? recipeId)
    {
        sideDishSuggestions.Clear();
        selectedSideDishIds.Clear();
        createdSideDishIds.Clear();
        mainCalendarEventCreated = false;
        if (string.IsNullOrWhiteSpace(recipeId)) return;

        try
        {
            sideDishSuggestions = await Client.Http.GetFromJsonAsync<List<RecipeSideDishDto>>($"/api/recipes/{recipeId}/side-dishes") ?? new List<RecipeSideDishDto>();
            selectedSideDishIds = sideDishSuggestions.Select(sd => sd.Id).ToHashSet();
        }
        catch
        {
            sideDishSuggestions = new List<RecipeSideDishDto>();
            selectedSideDishIds.Clear();
        }
    }

    private void ToggleSideDish(string recipeId, bool isSelected)
    {
        if (isSelected)
        {
            selectedSideDishIds.Add(recipeId);
        }
        else
        {
            selectedSideDishIds.Remove(recipeId);
        }
    }

    private class FormModel
    {
        public string? RecipeId { get; set; }
        public DateTime StartDate { get; set; } = DateTime.UtcNow.Date;
        public TimeSpan TimeOfDay { get; set; } = new TimeSpan(8,0,0);
        public AppointmentPeriod Period { get; set; } = AppointmentPeriod.Morning;
        public int Portions { get; set; } = 1;
        public RecurrenceType Recurrence { get; set; } = RecurrenceType.None;
        public WeekDays RecurrenceDays { get; set; } = WeekDays.None;

        public string TimeString
        {
            get => TimeOfDay.ToString(@"hh\:mm", System.Globalization.CultureInfo.InvariantCulture);
            set
            {
                if (string.IsNullOrWhiteSpace(value)) return;
                var formats = new[] { @"hh\:mm", @"h\:mm", @"HH\:mm", @"H\:mm", @"hh\:mm\:ss", @"HH\:mm\:ss" };
                if (TimeSpan.TryParseExact(value, formats, System.Globalization.CultureInfo.InvariantCulture, out var ts))
                {
                    TimeOfDay = ts;
                    return;
                }
                if (TimeSpan.TryParse(value, out ts))
                {
                    TimeOfDay = ts;
                }
            }
        }
    }
}
