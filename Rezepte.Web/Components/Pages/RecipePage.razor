@page "/recipes/{Id}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using Rezepte.Web.Components.Shared
@using Rezepte.Web.Configuration
@using Rezepte.Web.Models
@rendermode InteractiveServer
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IOptionsMonitor<ImageOptions> ImageOptionsMonitor
@inject ILogger<Rezepte.Web.Components.Pages.RecipePage> Logger

<PageTitle>@(recipe?.Title ?? "Rezept")</PageTitle>

<h5 class="mb-3 d-flex align-items-center justify-content-between">
    <span>
        @if (!isLoading && recipe is not null)
        {
            <button class="btn btn-sm btn-success me-2" @onclick="OpenScheduleDialog">Termin planen</button>
        }
    </span>
    @if (isOwner && !isLoading && recipe is not null)
    {
        <div class="btn-group">
            <button class="btn btn-sm btn-outline-secondary" title="Zutaten zur Einkaufsliste" @onclick="OpenShoppingListDialog">
                <span class="bi bi-cart-plus" aria-hidden="true"></span>
            </button>
            <a class="btn btn-sm btn-outline-secondary" href="/recipes/@Id/edit" title="Bearbeiten">✏️</a>

            @* Favoriten / Zuordnungen zu Kochbüchern *@
            <button class="btn btn-sm btn-outline-secondary" title="Zu Kochbüchern zuordnen" @onclick="OpenAssignOverlay">
                @if (isInAnyCookbook)
                {
                    <i class="bi bi-heart-fill text-danger"></i>
                }
                else
                {
                    <i class="bi bi-heart"></i>
                }
            </button>

            @if (!string.IsNullOrWhiteSpace(recipe.sourceUri))
            {
                <a class="btn btn-sm btn-outline-secondary"
                   href="@recipe.sourceUri"
                   title="Quelle aufrufen"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Quelle aufrufen (öffnet neues Fenster)">
                    ↗
                </a>
            }
        </div>
    }
</h5>

@if (isLoading)
{
    <div class="text-muted">Lade…</div>
}
else if (recipe is null)
{
    <div class="alert alert-warning">Rezept nicht gefunden.</div>
}
else
{
    <div class="row mb-3 g-3 align-items-start">
        <div class="col-12 col-md-6 position-relative">
            <div class="rounded shadow-sm bg-light w-100 position-relative" style="aspect-ratio: 4/3; overflow: hidden;">
                @if (!string.IsNullOrWhiteSpace(recipe.ImageUrl))
                {
                    <img src="@recipe.ImageUrl" alt="Rezeptfoto" class="img-fluid w-100 h-100" style="object-fit: cover;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center w-100 h-100" style="color:#bbb; font-size:3rem;">
                        <span>📷</span>
                    </div>
                }

                @* Accessible hidden InputFile (not display:none / not zero-size) so iOS Safari opens dialog via label *@
                <InputFile id="FotoUpload" style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden; opacity:0;" OnChange="OnImageSelected" accept="image/*" />

                @* Use a label as trigger rather than programmatic click for iOS Safari compatibility *@
                <label for="FotoUpload" class="btn btn-sm btn-primary position-absolute top-0 end-0 m-2" title="Foto hinzufügen" role="button" style="cursor:pointer;">
                    <i class="bi bi-camera"></i>
                </label>

                @if (recipe.ImageCount > 1)
                {
                    <button type="button" class="btn btn-sm btn-secondary position-absolute bottom-0 end-0 m-2" title="Alle Bilder anzeigen" @onclick="ShowAllImages">
                        <i class="bi bi-images"></i>
                    </button>
                }
            </div>
        </div>
        <div class="col-12 col-md-6">
            <h2 class="h4 mb-1">@recipe.Title</h2>
            @if (!string.IsNullOrWhiteSpace(recipe.Description))
                foreach (var line in @recipe.Description.Split("\r\n"))
                {
                    <div class="mb-2 text-muted">@line</div>
                }
            <div class="d-flex flex-wrap gap-3 align-items-center small text-secondary mb-2">
                @if (TotalMinutes > 0)
                {
                    <span><i class="bi bi-clock"></i> Gesamt: @TotalMinutes min</span>
                }
                @if (RestNights > 0)
                {
                    <span><i class="bi bi-moon"></i> Ruhenächte: @RestNights</span>
                }
            </div>
            @if (recipe.NumberOfPortions > 0)
            {
                <div class="d-flex flex-wrap gap-3 align-items-center small text-secondary mb-2">
                    <span><i class="bi bi-people-fill"></i> Portionen: @recipe.NumberOfPortions </span>
                </div>
            }
            @if (recipe.SideDishes?.Count > 0)
            {
                <div class="mt-3">
                    <div class="fw-semibold small text-secondary mb-2">Beilagen</div>
                    <div class="list-group">
                        @foreach (var sideDish in recipe.SideDishes)
                        {
                            <a class="list-group-item list-group-item-action" href="@($"/recipes/{sideDish.Id}")">@sideDish.Title</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="accordion" id="viewSteps">
        @for (var i = 0; i < recipe.Steps.Count; i++)
        {
            var s = recipe.Steps[i];
            var collapseId = $"vstep{i}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="vheading@i">
                    <button class="accordion-button @(i == 0 ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                        Schritt @(i + 1): @(string.IsNullOrWhiteSpace(s.Title) ? "(ohne Titel)" : s.Title) · @s.DurationMinutes min @(s.RequiresOvernightRest ? "· Ruhe über Nacht" : string.Empty)
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : string.Empty)" data-bs-parent="#viewSteps">
                    <div class="accordion-body">
                        @foreach (var line in s.Description.Split("\r\n"))
                        {
                            <div class="mb-2">@line</div>
                        }

                        @if (s.Ingredients?.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th style="width: 20%">Menge</th>
                                            <th style="width: 20%">Einheit</th>
                                            <th>Bezeichnung</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ing in s.Ingredients)
                                        {
                                            <tr>
                                                <td>@ing.Amount</td>
                                                <td>@ing.Unit</td>
                                                <td>@ing.Name</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<AddRecipeToShoppingListDialog Show="@showShoppingListDialog"
                               RecipeId="@Id"
                               RecipeTitle="@(recipe?.Title ?? "Rezept")"
                               OnClose="CloseShoppingListDialog"
                               OnAdded="OnShoppingListAdded" />

<PhotoOverlay Show="@showImagesOverlay"
              RezeptId="@Id"
              Mode="view"
              OnClose="CloseOverlay"
              OnShowLargeImage="ShowLargeImage" />

<!-- Overlay zum Zuordnen -->
<AssignToCookbooksOverlay Show="@showAssignOverlay"
                          RecipeId="@Id"
                          OnClose="CloseAssignOverlay"
                          OnSaved="OnCookbookAssignmentsSaved" />

@if (showCropper)
{
    <ImageCropper Show="@showCropper"
                  ImageDataUrl="@cropDataUrl"
                  UploadUrl="@($"/api/recipes/{Id}/image")"
                  OnUploaded="OnCroppedUploaded"
                  OnCancel="CloseCropper" />
}

@* Kalender‑Dialog für Termin anlegen/bearbeiten (Modal aktivieren) *@
@if (showCalendarDialog && recipe is not null)
{
    <CalendarEventDialog Modal="true"
                         EditingId="@null"
                         InitialEvent="calendarInitialEvent"
                         OnSaved="OnCalendarSaved"
                         OnCancel="OnCalendarCanceled" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private bool isLoading = true;
    private RecipeDto? recipe;

    // Overlay-Logik
    private bool showImagesOverlay = false;
    private List<RecipeImageDto>? images;
    private string? largeImageUrl;

    private bool showCropper;
    private string? cropDataUrl;

    private string errorMessage = string.Empty;

    // Assign overlay
    private bool showAssignOverlay = false;
    private bool isInAnyCookbook = false;
    private bool showShoppingListDialog = false;

    private int TotalMinutes => recipe?.Steps?.Sum(s => s.DurationMinutes) ?? 0;
    private int RestNights => recipe?.Steps?.Count(s => s.RequiresOvernightRest) ?? 0;

    private string? currentUserId;
    private bool isOwner => !string.IsNullOrEmpty(recipe?.OwnerId) && recipe?.OwnerId == currentUserId;

    // Kalender dialog state
    private bool showCalendarDialog;
    private CalendarEventDto? calendarInitialEvent;

    private async Task OpenScheduleDialog()
    {
        // Debug: log to browser console to verify click handler fires
        await JS.InvokeVoidAsync("console.log", $"OpenScheduleDialog clicked for recipe {Id}");

        // Prepare initial event filled with this recipe Id
        calendarInitialEvent = new CalendarEventDto(
            EventId: null,
            RecipeId: Id,
            StartDate: DateTime.UtcNow.Date,
            TimeOfDay: new TimeSpan(8, 0, 0),
            Portions: 1,
            Recurrence: Rezepte.Web.Entities.RecurrenceType.None,
            RecurrenceDays: Rezepte.Web.Entities.WeekDays.None);

        showCalendarDialog = true;
        StateHasChanged();
    }

    private async Task OnCalendarSaved()
    {
        showCalendarDialog = false;
        // optional: reload recipe or show notification
        try
        {
            recipe = await Api.Http.GetFromJsonAsync<RecipeDto>($"api/recipes/{Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reloading recipe {RecipeId} after saving a calendar entry failed", Id);
        }
        StateHasChanged();
    }

    private Task OnCalendarCanceled()
    {
        showCalendarDialog = false;
        return Task.CompletedTask;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Reset previous error
        errorMessage = string.Empty;

        // Validate size first — if too large, show error and don't open dialog
        if (file.Size > ImageOptionsMonitor.CurrentValue.MaxSizeBytes)
        {
            errorMessage = $"Die Größe des Bildes überschreitet den maximalen Wert.";
            return;
        }

        // Show cropper overlay immediately so user sees loading state
        cropDataUrl = null;
        showCropper = true;
        StateHasChanged(); // force render so overlay + "Lade Vorschau…" erscheint

        try
        {
            // Convert file to data URL asynchronously
            using var ms = new MemoryStream();
            await file.OpenReadStream(ImageOptionsMonitor.CurrentValue.MaxSizeBytes).CopyToAsync(ms);
            var bytes = ms.ToArray();
            var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";

            // Assign the prepared data URL -> ImageCropper will initialize the cropper
            cropDataUrl = dataUrl;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // conversion failed -> close overlay and show error
            showCropper = false;
            cropDataUrl = null;
            errorMessage = "Fehler beim Laden der Bilddatei.";
            Logger.LogError(ex, "Could not read the selected image file for recipe {RecipeId}", Id);
        }
    }

    private async Task OnCroppedUploaded(bool ok)
    {
        showCropper = false;
        cropDataUrl = null;
        if (ok)
        {
            // Bild wurde per JS direkt hochgeladen — Rezept neu laden
            recipe = await Api.Http.GetFromJsonAsync<RecipeDto>($"api/recipes/{Id}");
            StateHasChanged();
        }
        else
        {
            // Fehlermeldung anzeigen
            await JS.InvokeVoidAsync("alert", "Bild konnte nicht hochgeladen werden. Bitte erneut versuchen.");
        }
    }

    private Task CloseCropper()
    {
        showCropper = false;
        cropDataUrl = null;
        return Task.CompletedTask;
    }

    private async Task ShowAllImages()
    {
        showImagesOverlay = true;
        images = null;
        StateHasChanged();
        images = await Api.Http.GetFromJsonAsync<List<RecipeImageDto>>($"api/recipes/{Id}/images");
        StateHasChanged();
    }

    private void CloseOverlay()
    {
        showImagesOverlay = false;
        images = null;
    }

    private void ShowLargeImage(string url)
    {
        largeImageUrl = url;
    }

    private void CloseLargeImage()
    {
        largeImageUrl = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        try
        {
            recipe = await Api.Http.GetFromJsonAsync<RecipeDto>($"api/recipes/{Id}");
            await CheckIfInAnyCookbook();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading recipe {RecipeId} failed", Id);
            recipe = null;
        }
        finally { isLoading = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst("sub")?.Value // oder "nameidentifier" je nach Claim
            ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private void OpenAssignOverlay()
    {
        showAssignOverlay = true;
    }

    private void OpenShoppingListDialog()
    {
        showShoppingListDialog = true;
    }

    private Task CloseShoppingListDialog()
    {
        showShoppingListDialog = false;
        return Task.CompletedTask;
    }

    private async Task OnShoppingListAdded()
    {
        showShoppingListDialog = false;
        await JS.InvokeVoidAsync("console.log", $"Recipe {Id} added to shopping list.");
    }

    private void CloseAssignOverlay()
    {
        showAssignOverlay = false;
    }

    private async Task OnCookbookAssignmentsSaved(bool changed)
    {
        showAssignOverlay = false;
        if (changed)
        {
            // nach Änderung neu prüfen / ggf. Daten neu laden
            await CheckIfInAnyCookbook();
            // optional: recipe neu laden
            recipe = await Api.Http.GetFromJsonAsync<RecipeDto>($"api/recipes/{Id}");
            StateHasChanged();
        }
    }

    /// <summary>
    /// Prüft, ob das Rezept in mindestens einem Kochbuch enthalten ist.
    /// Hinweis: Endpoint "GET api/recipes/{id}/cookbooks" muss vorhanden sein und eine Liste Cookbook-Ids oder -Objekte liefern.
    /// Falls euer API andere URLs verwendet, passe hier die URL an.
    /// </summary>
    private async Task CheckIfInAnyCookbook()
    {
        try
        {
            var list = await Api.Http.GetFromJsonAsync<List<string>>($"api/recipes/{Id}/cookbooks");
            isInAnyCookbook = list != null && list.Count > 0;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not determine the cookbooks of recipe {RecipeId}", Id);
            isInAnyCookbook = false;
        }
    }

    private record RecipeDto(string Id, string CookbookId, string OwnerId, string Title, string? Description, int NumberOfPortions, List<RecipeStepDto> Steps, string? ImageUrl = null, string? sourceUri = null, int ImageCount = 0, List<RecipeSideDishDto>? SideDishes = null);
    private record RecipeStepDto(string Id, int StepIndex, string? Title, string Description, int DurationMinutes, bool RequiresOvernightRest, List<RecipeIngredientDto> Ingredients);
    private record RecipeIngredientDto(string Id, decimal Amount, string? Unit, string Name);
    private record RecipeImageDto(string Id, string Url);
    private record RecipeSideDishDto(string Id, string Title, string? Description, string? ImageUrl, int Portions);
}
