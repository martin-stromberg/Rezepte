@page "/recipes/search"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@inject ApiClient Client
@inject NavigationManager Nav
@inject ILogger<Rezepte.Web.Components.Pages.RecipeSearch> Logger

<PageTitle>Rezepte – Suche</PageTitle>

<div class="mb-4 d-flex align-items-start gap-3">
    <form class="d-flex flex-grow-1" @onsubmit="OnSubmitSearch" role="search">
        <input id="search-q" name="q" class="form-control" placeholder="Rezepte suchen (Titel, Zutaten, Tags)..." aria-label="Suche Rezepte"
               @bind="searchQuery" @bind:event="oninput" />
        <button type="submit" class="btn btn-accent ms-2">Suchen</button>
    </form>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status" aria-hidden="true"></div>
        <div class="mt-2">Suche läuft…</div>
    </div>
}
else if (searchFailed)
{
    <div class="alert alert-danger">Die Suche ist fehlgeschlagen. Bitte versuche es erneut.</div>
}
else if (results?.Any() != true)
{
    <div class="alert alert-secondary">Keine Treffer.</div>
}
else
{
    <div class="list-group">
        @foreach (var r in results)
        {
            <a class="list-group-item list-group-item-action d-flex gap-3 align-items-start" href="@($"/recipes/{r.Id}")" >
                @if (!string.IsNullOrEmpty(r.PrimaryImageUrl))
                {
                    <img src="@r.PrimaryImageUrl" alt="" class="rounded" style="width:64px;height:64px;object-fit:cover" />
                }
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="mb-1">@r.Title</h5>
                        <small class="text-muted">@r.PublishedLabel</small>
                    </div>
                    <p class="mb-1 text-muted">@r.Snippet</p>
                    @if (r.Tags?.Any() == true)
                    {
                        <div class="small text-muted">
                            @foreach (var t in r.Tags) { <span class="badge bg-light text-dark me-1">@t</span> }
                        </div>
                    }
                </div>
            </a>
        }
    </div>

    <nav class="mt-3" aria-label="Seitennavigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(pageNumber - 1)" aria-label="Vorherige">«</button>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Seite @pageNumber von @TotalPages</span>
            </li>
            <li class="page-item @(pageNumber >= TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(pageNumber + 1)" aria-label="Nächste">»</button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "q")]
    public string? q { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "page")]
    public int pageNumber { get; set; } = 1;

    [Parameter]
    [SupplyParameterFromQuery(Name = "pageSize")]
    public int pageSize { get; set; } = 10;

    private string searchQuery = string.Empty;
    private bool isLoading;
    private bool searchFailed;
    private CancellationTokenSource? cts;
    private RecipeResult[] results = Array.Empty<RecipeResult>();
    private int totalItems;

    private int CurrentPageSize => pageSize == 0 ? 20 : pageSize;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalItems / (double)CurrentPageSize));

    protected override async Task OnParametersSetAsync()
    {
        // keep UI input in sync with query param
        searchQuery = q ?? string.Empty;
        await RunSearchAsync();
    }

    private async Task OnSubmitSearch()
    {
        // navigate to first page with query -> URL changes and triggers OnParametersSetAsync
        var query = string.IsNullOrWhiteSpace(searchQuery) ? string.Empty : Uri.EscapeDataString(searchQuery.Trim());
        Nav.NavigateTo($"/recipes/search?q={query}&page=1&pageSize={pageSize}", forceLoad: false);
        await Task.CompletedTask;
    }

    private async Task RunSearchAsync()
    {
        cts?.Cancel();
        cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        var token = cts.Token;

        try
        {
            isLoading = true;
            searchFailed = false;
            results = Array.Empty<RecipeResult>();
            totalItems = 0;

            var qParam = string.IsNullOrWhiteSpace(q) ? string.Empty : Uri.EscapeDataString(q);
            var uri = $"/api/recipes/search?q={qParam}&page={pageNumber}&pageSize={CurrentPageSize}";

            var resp = await Client.Http.GetFromJsonAsync<SearchResponseDto>(uri, token);
            if (resp != null)
            {
                results = resp.Items ?? Array.Empty<RecipeResult>();
                totalItems = resp.Total;
            }
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogInformation(ex, "Recipe search for query {Query} was cancelled or timed out", q);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Recipe search for query {Query} failed", q);
            searchFailed = true;
            results = Array.Empty<RecipeResult>();
            totalItems = 0;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ChangePage(int newPage)
    {
        if (newPage < 1) newPage = 1;
        if (newPage > TotalPages) newPage = TotalPages;
        Nav.NavigateTo($"/recipes/search?q={Uri.EscapeDataString(q ?? string.Empty)}&page={newPage}&pageSize={pageSize}");
    }

    // DTOs / view models used by the page (map from API response)
    private sealed record RecipeResult(string Id, string Title, string Snippet, string? PrimaryImageUrl, string[]? Cookbooks, string[]? Tags, string? PublishedLabel = null);
    private sealed record SearchResponseDto(RecipeResult[]? Items, int Total);
}