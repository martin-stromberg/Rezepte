@page "/recipes/search"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Rezepte.Web.Services
@using System.Security.Claims
@attribute [Authorize]
@inject IRecipeService RecipeService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ILogger<Rezepte.Web.Components.Pages.RecipeSearch> Logger
@inject IStringLocalizer<UiStrings> Localizer
@inject IJSRuntime JS

<PageTitle>@Localizer["RecipeSearchPageTitle"]</PageTitle>

<div class="mb-4 d-flex align-items-start gap-3">
    @* Plain GET form without @onsubmit or @bind: the browser submits the live input
       value, so the search works before/without the interactive circuit and the typed
       text can never be overwritten by a re-render of a controlled two-way binding.
       The value attribute is only emitted when q actually changes relative to the
       query the DOM input is believed to show, so interactive re-renders - including
       the circuit start after prerendering - never write a stale query back over text
       the user already typed. Mounts that insert a fresh input element (enhanced-
       navigation remounts) would otherwise leave it empty, so OnAfterRenderAsync
       fills a still-empty field with the current query via rezepteSetInputValueIfEmpty.
       No action attribute - the form posts to the current URL, which keeps any
       configured PathBase intact. *@
    <form class="d-flex flex-grow-1" method="get" role="search">
        <input id="search-q" name="q" class="form-control" placeholder="@Localizer["SearchRecipeInputPlaceholder"]" aria-label="@Localizer["SearchRecipes"]"
               value="@(emitSearchValue ? (q ?? string.Empty) : null)" />
        <input type="hidden" name="pageSize" value="@CurrentPageSize" />
        <button type="submit" class="btn btn-accent ms-2">@Localizer["SearchSubmit"]</button>
    </form>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status" aria-hidden="true"></div>
        <div class="mt-2">@Localizer["SearchInProgress"]</div>
    </div>
}
else if (searchFailed)
{
    <div class="alert alert-danger">@Localizer["SearchFailed"]</div>
}
else if (results?.Any() != true)
{
    <div class="alert alert-secondary">@Localizer["NoSearchResults"]</div>
}
else
{
    <div class="list-group">
        @foreach (var r in results)
        {
            <a class="list-group-item list-group-item-action d-flex gap-3 align-items-start" href="@($"/recipes/{r.Id}")" >
                @if (!string.IsNullOrEmpty(r.PrimaryImageUrl))
                {
                    <img src="@r.PrimaryImageUrl" alt="" class="rounded" style="width:64px;height:64px;object-fit:cover" />
                }
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="mb-1">@r.Title</h5>
                        <small class="text-muted">@r.PublishedLabel</small>
                    </div>
                    <p class="mb-1 text-muted">@r.Snippet</p>
                    @if (r.Tags?.Any() == true)
                    {
                        <div class="small text-muted">
                            @foreach (var t in r.Tags) { <span class="badge bg-light text-dark me-1">@t</span> }
                        </div>
                    }
                </div>
            </a>
        }
    </div>

    <nav class="mt-3" aria-label="@Localizer["PageNavigation"]">
        <ul class="pagination justify-content-center">
            <li class="page-item @(CurrentPage <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)" aria-label="@Localizer["PreviousPage"]">«</button>
            </li>
            <li class="page-item disabled">
                <span class="page-link">@Localizer["SearchPageOf", CurrentPage, TotalPages]</span>
            </li>
            <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)" aria-label="@Localizer["NextPage"]">»</button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "q")]
    public string? q { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "page")]
    public int pageNumber { get; set; } = 1;

    [Parameter]
    [SupplyParameterFromQuery(Name = "pageSize")]
    public int pageSize { get; set; } = 10;

    // Carries the query rendered during prerendering into the interactive component
    // instance, so the first interactive render knows which query the input already shows.
    [PersistentState]
    public string? PrerenderedSearchQuery { get; set; }

    private bool isLoading;
    private bool searchFailed;
    private bool searchFieldPrimed;
    private bool emitSearchValue;
    private string? syncedSearchQuery;
    private CancellationTokenSource? cts;
    private RecipeResult[] results = Array.Empty<RecipeResult>();
    private int totalItems;

    private int CurrentPage => pageNumber < 1 ? 1 : pageNumber;
    private int CurrentPageSize => pageSize < 1 ? 20 : Math.Min(pageSize, IRecipeService.MaxSearchPageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalItems / (double)CurrentPageSize));

    protected override void OnParametersSet()
    {
        if (!searchFieldPrimed)
        {
            // After a prerender→interactive handover the restored value is the query
            // the input already displays. On other mounts it may match the current q
            // as well (enhanced-navigation remounts restore the freshly persisted
            // value), so the emit suppression alone cannot tell whether the DOM input
            // really shows q - the empty-field backstop in OnAfterRenderAsync covers
            // the freshly inserted case.
            syncedSearchQuery = PrerenderedSearchQuery;
            searchFieldPrimed = true;
        }

        emitSearchValue = !string.Equals(q, syncedSearchQuery, StringComparison.Ordinal);
        syncedSearchQuery = q;
        PrerenderedSearchQuery = q;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The suppression of the value attribute is only safe when the DOM input
        // already shows the query (the attach mount keeps the prerendered element,
        // which holds the query or typed text). An input that ends up empty after
        // the first render - a fresh element inserted by a remount in the same
        // circuit - must receive the query once, or it would stay blank forever.
        // A non-empty field is never touched: it holds the query or the user's text.
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("rezepteSetInputValueIfEmpty", "search-q", q ?? string.Empty);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
            {
                // cosmetic assist only - a lost call leaves the field empty, never corrupts it
                Logger.LogDebug(ex, "Search field backfill skipped: JS interop unavailable");
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await RunSearchAsync();
    }

    private async Task RunSearchAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var localCts = cts;
        var token = localCts.Token;

        try
        {
            isLoading = true;
            searchFailed = false;
            results = Array.Empty<RecipeResult>();
            totalItems = 0;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrEmpty(userId))
            {
                Logger.LogWarning("Recipe search for query {Query} skipped: no authenticated user", q);
                searchFailed = true;
                return;
            }

            // Direct service call instead of an HTTP self-call: a request to the public base
            // URI goes out through the router's port forwarding and back in, which can stall
            // on low-performance hosts (e.g. NAS) and previously surfaced as a timeout.
            var search = await RecipeService.SearchAsync(userId, q, null, null, CurrentPage, CurrentPageSize, "newest", token);
            results = search.Items
                .Select(i => new RecipeResult(i.Id, i.Title, i.Snippet, i.PrimaryImageUrl, null, i.Tags, i.PublishedLabel))
                .ToArray();
            totalItems = search.TotalCount;
        }
        catch (OperationCanceledException ex)
        {
            if (ReferenceEquals(cts, localCts))
            {
                Logger.LogWarning(ex, "Recipe search for query {Query} was cancelled or timed out", q);
                searchFailed = true;
                results = Array.Empty<RecipeResult>();
                totalItems = 0;
            }
            else
            {
                Logger.LogInformation(ex, "Recipe search for query {Query} was superseded by a newer search", q);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Recipe search for query {Query} failed", q);
            searchFailed = true;
            results = Array.Empty<RecipeResult>();
            totalItems = 0;
        }
        finally
        {
            // a superseded search must not reset the loading state of the newer search
            if (ReferenceEquals(cts, localCts))
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
        // null the field so an in-flight search aborted by this teardown is classified
        // as superseded rather than as a cancellation/timeout failure
        cts = null;
    }

    private void ChangePage(int newPage)
    {
        if (newPage < 1) newPage = 1;
        if (newPage > TotalPages) newPage = TotalPages;
        Nav.NavigateTo($"/recipes/search?q={Uri.EscapeDataString(q ?? string.Empty)}&page={newPage}&pageSize={CurrentPageSize}");
    }

    // view model used by the page (mapped from the service result)
    private sealed record RecipeResult(string Id, string Title, string Snippet, string? PrimaryImageUrl, string[]? Cookbooks, string[]? Tags, string? PublishedLabel = null);
}