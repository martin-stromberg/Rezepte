@page "/recipes/search"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components
@inject ApiClient Client
@inject NavigationManager Nav
@inject ILogger<Rezepte.Web.Components.Pages.RecipeSearch> Logger
@inject IStringLocalizer<UiStrings> Localizer

<PageTitle>@Localizer["RecipeSearchPageTitle"]</PageTitle>

<div class="mb-4 d-flex align-items-start gap-3">
    @* Plain GET form without @onsubmit: the browser submits the live input value, so the
       search keeps working even when the typed input events were lost before the
       interactive circuit bound them. No action attribute - the form posts to the
       current URL, which keeps any configured PathBase intact. *@
    <form class="d-flex flex-grow-1" method="get" role="search">
        <input id="search-q" name="q" class="form-control" placeholder="@Localizer["SearchRecipeInputPlaceholder"]" aria-label="@Localizer["SearchRecipes"]"
               @bind="searchQuery" @bind:event="oninput" />
        <input type="hidden" name="pageSize" value="@CurrentPageSize" />
        <button type="submit" class="btn btn-accent ms-2">@Localizer["SearchSubmit"]</button>
    </form>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status" aria-hidden="true"></div>
        <div class="mt-2">@Localizer["SearchInProgress"]</div>
    </div>
}
else if (searchFailed)
{
    <div class="alert alert-danger">@Localizer["SearchFailed"]</div>
}
else if (results?.Any() != true)
{
    <div class="alert alert-secondary">@Localizer["NoSearchResults"]</div>
}
else
{
    <div class="list-group">
        @foreach (var r in results)
        {
            <a class="list-group-item list-group-item-action d-flex gap-3 align-items-start" href="@($"/recipes/{r.Id}")" >
                @if (!string.IsNullOrEmpty(r.PrimaryImageUrl))
                {
                    <img src="@r.PrimaryImageUrl" alt="" class="rounded" style="width:64px;height:64px;object-fit:cover" />
                }
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="mb-1">@r.Title</h5>
                        <small class="text-muted">@r.PublishedLabel</small>
                    </div>
                    <p class="mb-1 text-muted">@r.Snippet</p>
                    @if (r.Tags?.Any() == true)
                    {
                        <div class="small text-muted">
                            @foreach (var t in r.Tags) { <span class="badge bg-light text-dark me-1">@t</span> }
                        </div>
                    }
                </div>
            </a>
        }
    </div>

    <nav class="mt-3" aria-label="@Localizer["PageNavigation"]">
        <ul class="pagination justify-content-center">
            <li class="page-item @(CurrentPage <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)" aria-label="@Localizer["PreviousPage"]">«</button>
            </li>
            <li class="page-item disabled">
                <span class="page-link">@Localizer["SearchPageOf", CurrentPage, TotalPages]</span>
            </li>
            <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)" aria-label="@Localizer["NextPage"]">»</button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "q")]
    public string? q { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "page")]
    public int pageNumber { get; set; } = 1;

    [Parameter]
    [SupplyParameterFromQuery(Name = "pageSize")]
    public int pageSize { get; set; } = 10;

    private string searchQuery = string.Empty;
    private bool isLoading;
    private bool searchFailed;
    private CancellationTokenSource? cts;
    private RecipeResult[] results = Array.Empty<RecipeResult>();
    private int totalItems;

    private int CurrentPage => pageNumber < 1 ? 1 : pageNumber;
    private int CurrentPageSize => pageSize < 1 ? 20 : pageSize;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalItems / (double)CurrentPageSize));

    protected override async Task OnParametersSetAsync()
    {
        // keep UI input in sync with query param
        searchQuery = q ?? string.Empty;
        await RunSearchAsync();
    }

    private async Task RunSearchAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        var localCts = cts;
        var token = localCts.Token;

        try
        {
            isLoading = true;
            searchFailed = false;
            results = Array.Empty<RecipeResult>();
            totalItems = 0;

            var qParam = string.IsNullOrWhiteSpace(q) ? string.Empty : Uri.EscapeDataString(q);
            var uri = $"api/recipes/search?q={qParam}&page={CurrentPage}&pageSize={CurrentPageSize}";

            var resp = await Client.Http.GetFromJsonAsync<SearchResponseDto>(uri, token);
            if (resp != null)
            {
                results = resp.Items ?? Array.Empty<RecipeResult>();
                totalItems = resp.Total;
            }
        }
        catch (OperationCanceledException ex)
        {
            if (ReferenceEquals(cts, localCts))
            {
                Logger.LogWarning(ex, "Recipe search for query {Query} was cancelled or timed out", q);
                searchFailed = true;
                results = Array.Empty<RecipeResult>();
                totalItems = 0;
            }
            else
            {
                Logger.LogInformation(ex, "Recipe search for query {Query} was superseded by a newer search", q);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Recipe search for query {Query} failed", q);
            searchFailed = true;
            results = Array.Empty<RecipeResult>();
            totalItems = 0;
        }
        finally
        {
            // a superseded search must not reset the loading state of the newer search
            if (ReferenceEquals(cts, localCts))
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
        // null the field so an in-flight search aborted by this teardown is classified
        // as superseded rather than as a cancellation/timeout failure
        cts = null;
    }

    private void ChangePage(int newPage)
    {
        if (newPage < 1) newPage = 1;
        if (newPage > TotalPages) newPage = TotalPages;
        Nav.NavigateTo($"/recipes/search?q={Uri.EscapeDataString(q ?? string.Empty)}&page={newPage}&pageSize={CurrentPageSize}");
    }

    // DTOs / view models used by the page (map from API response)
    private sealed record RecipeResult(string Id, string Title, string Snippet, string? PrimaryImageUrl, string[]? Cookbooks, string[]? Tags, string? PublishedLabel = null);
    private sealed record SearchResponseDto(RecipeResult[]? Items, int Total);
}