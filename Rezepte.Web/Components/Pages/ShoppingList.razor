@page "/shopping-list"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using System.Security.Claims
@using Rezepte.Web.Entities
@using Rezepte.Web.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject IShoppingListService ShoppingListService
@inject ISettingsService SettingsService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Einkaufsliste</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0">Einkaufsliste</h2>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group btn-group-sm" role="group" aria-label="Anzeigemodus">
            <button type="button"
                    class="btn @(isEditMode ? "btn-outline-secondary" : "btn-secondary")"
                    aria-pressed="@(!isEditMode)"
                    aria-label="Ansicht"
                    title="Ansicht"
                    @onclick="async () => await SetEditModeAsync(false)">
                <span class="bi bi-eye" aria-hidden="true"></span>
            </button>
            <button type="button"
                    class="btn @(isEditMode ? "btn-secondary" : "btn-outline-secondary")"
                    aria-pressed="@isEditMode"
                    aria-label="Bearbeiten"
                    title="Bearbeiten"
                    @onclick="async () => await SetEditModeAsync(true)">
                <span class="bi bi-pencil" aria-hidden="true"></span>
            </button>
        </div>
        @if (isEditMode)
        {
            <button type="button" class="btn btn-sm btn-primary" @onclick="AddGroupAsync" title="Gruppe hinzufügen">
                <span class="bi bi-folder-plus" aria-hidden="true"></span>
                <span class="ms-1">Gruppe</span>
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") py-2">@message</div>
}

@if (isLoading)
{
    <div class="text-muted">Lade...</div>
}
else
{
    <div class="shopping-list-grid">
        @foreach (var group in groups)
        {
            var draft = DraftFor(group.Id);
            <section class="shopping-group">
                @if (isEditMode)
                {
                    <div class="shopping-group-header">
                        <input class="form-control form-control-sm shopping-group-title"
                               value="@group.Name"
                               @onchange="async e => await RenameGroupAsync(group, e.Value?.ToString() ?? string.Empty)"
                               aria-label="Gruppenname" />
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                title="Gruppe löschen"
                                aria-label="Gruppe löschen"
                                @onclick="async () => await DeleteGroupAsync(group.Id)">
                            <span class="bi bi-trash" aria-hidden="true"></span>
                        </button>
                    </div>
                }
                else
                {
                    <h3 class="h6 mb-2">@group.Name</h3>
                }

                @if (!string.IsNullOrWhiteSpace(group.RecipeId))
                {
                    <div class="small text-muted mb-2">Aus Rezept übernommen</div>
                }

                @if (group.Items.Count == 0)
                {
                    <div class="text-muted small py-3">Noch keine Zutaten in dieser Gruppe.</div>
                }
                else
                {
                    <div class="shopping-items">
                        @foreach (var item in group.Items)
                        {
                            <div class="shopping-item @(isEditMode ? "shopping-item-edit" : "shopping-item-view") @(item.IsChecked ? "is-checked" : string.Empty)">
                                @if (isEditMode)
                                {
                                    <input class="form-control form-control-sm shopping-item-quantity"
                                           value="@FormatQuantity(item)"
                                           aria-label="Menge und Einheit"
                                           @onchange="async e => await UpdateItemQuantityAsync(item, e.Value?.ToString())" />
                                    <input class="form-control form-control-sm shopping-item-name"
                                           value="@item.Name"
                                           aria-label="Zutat"
                                           @onchange="async e => await UpdateItemNameAsync(item, e.Value?.ToString() ?? string.Empty)" />
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Zutat löschen"
                                            aria-label="Zutat löschen"
                                            @onclick="async () => await DeleteItemAsync(item.Id)">
                                        <span class="bi bi-x-lg" aria-hidden="true"></span>
                                    </button>
                                }
                                else
                                {
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@item.IsChecked"
                                           aria-label="@($"{item.Name} abhaken")"
                                           @onchange="async e => await SetItemCheckedAsync(item.Id, e.Value is bool checkedValue && checkedValue)" />
                                    <span class="shopping-item-text">@FormatIngredient(item)</span>
                                }
                            </div>
                        }
                    </div>
                }

                @if (isEditMode)
                {
                    <form class="shopping-add-row" @onsubmit="async () => await AddItemAsync(group.Id)" @onsubmit:preventDefault="true">
                        <input class="form-control form-control-sm"
                               @ref="draft.AmountInput"
                               type="number"
                               min="0"
                               step="0.01"
                               placeholder="Menge"
                               aria-label="Menge"
                               @bind="draft.AmountText" />
                        <input class="form-control form-control-sm"
                               placeholder="Einheit"
                               aria-label="Einheit"
                               @bind="draft.Unit" />
                        <input class="form-control form-control-sm"
                               placeholder="Zutat hinzufügen"
                               aria-label="Zutat hinzufügen"
                               @bind="draft.Name" />
                        <button type="submit" class="btn btn-sm btn-success" title="Zutat hinzufügen" aria-label="Zutat hinzufügen">
                            <span class="bi bi-plus-lg" aria-hidden="true"></span>
                        </button>
                    </form>
                }
            </section>
        }
    </div>
}

@code {
    private readonly Dictionary<string, ItemDraft> drafts = new();
    private List<ShoppingListGroup> groups = new();
    private string? userId;
    private string? message;
    private bool isError;
    private bool isLoading = true;
    private bool isEditMode;
    private string? pendingFocusGroupId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrWhiteSpace(userId))
        {
            isEditMode = await SettingsService.GetUserShoppingListEditModeAsync(userId, CancellationToken.None);
        }

        await LoadAsync();
        if (isEditMode && groups.Count == 1)
        {
            pendingFocusGroupId = groups[0].Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isEditMode || string.IsNullOrWhiteSpace(pendingFocusGroupId))
        {
            return;
        }

        var focusGroupId = pendingFocusGroupId;
        pendingFocusGroupId = null;
        if (drafts.TryGetValue(focusGroupId, out var draft))
        {
            await draft.AmountInput.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        if (!string.IsNullOrWhiteSpace(userId))
        {
            groups = await ShoppingListService.GetGroupsAsync(userId, CancellationToken.None);
        }
        isLoading = false;
    }

    private async Task AddGroupAsync()
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var result = await ShoppingListService.AddGroupAsync(userId, "Neue Gruppe", CancellationToken.None);
        await AfterMutationAsync(result.ok, result.error, focusGroupId: result.group?.Id);
    }

    private async Task RenameGroupAsync(ShoppingListGroup group, string name)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var result = await ShoppingListService.RenameGroupAsync(userId, group.Id, name, CancellationToken.None);
        await AfterMutationAsync(result.ok, result.error);
    }

    private async Task DeleteGroupAsync(string groupId)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var result = await ShoppingListService.DeleteGroupAsync(userId, groupId, CancellationToken.None);
        drafts.Remove(groupId);
        await AfterMutationAsync(result.ok, result.error);
    }

    private async Task AddItemAsync(string groupId)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var draft = DraftFor(groupId);
        var amount = ShoppingListQuantityParser.ParseAmount(draft.AmountText);
        var result = await ShoppingListService.AddItemAsync(userId, groupId, amount, draft.Unit, draft.Name, CancellationToken.None);
        if (result.ok)
        {
            draft.AmountText = string.Empty;
            draft.Unit = string.Empty;
            draft.Name = string.Empty;
        }
        await AfterMutationAsync(result.ok, result.error, focusGroupId: groupId);
    }

    private async Task SetEditModeAsync(bool editMode)
    {
        if (isEditMode == editMode)
        {
            return;
        }

        isEditMode = editMode;
        if (!string.IsNullOrWhiteSpace(userId))
        {
            await SettingsService.SetUserShoppingListEditModeAsync(userId, editMode, CancellationToken.None);
        }

        if (isEditMode && groups.Count == 1)
        {
            pendingFocusGroupId = groups[0].Id;
        }
    }

    private async Task UpdateItemQuantityAsync(ShoppingListItem item, string? quantityText)
    {
        var (amount, unit) = ShoppingListQuantityParser.ParseQuantity(quantityText);
        await UpdateItemAsync(item, amount, unit, item.Name);
    }

    private async Task UpdateItemNameAsync(ShoppingListItem item, string name)
    {
        await UpdateItemAsync(item, item.Amount, item.Unit, name);
    }

    private async Task UpdateItemAsync(ShoppingListItem item, decimal amount, string? unit, string name)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var result = await ShoppingListService.UpdateItemAsync(userId, item.Id, amount, unit, name, CancellationToken.None);
        await AfterMutationAsync(result.ok, result.error);
    }

    private async Task SetItemCheckedAsync(string itemId, bool isChecked)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var result = await ShoppingListService.SetItemCheckedAsync(userId, itemId, isChecked, CancellationToken.None);
        await AfterMutationAsync(result.ok, result.error, successMessage: null);
    }

    private async Task DeleteItemAsync(string itemId)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var result = await ShoppingListService.DeleteItemAsync(userId, itemId, CancellationToken.None);
        await AfterMutationAsync(result.ok, result.error);
    }

    private async Task AfterMutationAsync(bool ok, string? error, string? successMessage = "", string? focusGroupId = null)
    {
        isError = !ok;
        message = ok ? successMessage : error;
        await LoadAsync();
        if (ok && isEditMode && !string.IsNullOrWhiteSpace(focusGroupId))
        {
            pendingFocusGroupId = focusGroupId;
        }
    }

    private ItemDraft DraftFor(string groupId)
    {
        if (!drafts.TryGetValue(groupId, out var draft))
        {
            draft = new ItemDraft();
            drafts[groupId] = draft;
        }

        return draft;
    }

    private static string FormatAmount(decimal amount)
    {
        return amount == 0 ? string.Empty : amount.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static string FormatQuantity(ShoppingListItem item)
    {
        return string.Join(" ", new[] { FormatAmount(item.Amount), item.Unit }.Where(v => !string.IsNullOrWhiteSpace(v)));
    }

    private static string FormatIngredient(ShoppingListItem item)
    {
        return string.Join(" ", new[] { FormatAmount(item.Amount), item.Unit, item.Name }.Where(v => !string.IsNullOrWhiteSpace(v)));
    }

    private sealed class ItemDraft
    {
        public string AmountText { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public ElementReference AmountInput { get; set; }
    }
}
