@page "/"
@using Rezepte.Web.Components.Shared
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Rezepte</PageTitle>

<h5 class="mb-3 d-flex align-items-center justify-content-between">
    <span></span>
    <div class="btn-group">
        <button class="btn btn-sm btn-outline-primary" @onclick="ToggleCreateMenu" disabled="@isCreating" title="Neues Rezept anlegen">
            @if (isCreating)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <span>+ Neu</span>
            }
        </button>
    </div>
</h5>

<h2>Zuletzt hinzugefügte Rezepte</h2>

@if (isLoading)
{
    <div>Lade Rezepte…</div>
}
else if (recipes is null || recipes.Count == 0)
{
    <div class="alert alert-info">Noch keine Rezepte vorhanden.</div>
}
else
{
    <div class="recipe-grid">
        @foreach (var recipe in recipes)
        {
            <a class="recipe-card" href="@($"/recipes/{recipe.Id}")" title="@recipe.Title">
                @if (!string.IsNullOrWhiteSpace(recipe.ImageUrl))
                {
                    <img src="@recipe.ImageUrl" alt="Bild zu @recipe.Title" />
                }
                else
                {
                    <div class="no-image">📷</div>
                }
                <div class="recipe-title">@recipe.Title</div>
            </a>
        }
    </div>
}

<CreateRecipeDialog @ref="createDialog" OnClosed="HandleCreateDialogClosed" />

@code {
    private List<RecipeListItemDto>? recipes;
    private bool isLoading = true;
    private bool isCreating;
    private string importUrl = string.Empty;
    private bool isImporting;
    private string? importMessage;
    private string importStatus = string.Empty;
    
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            await LoadLists();
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task LoadLists()
    {
        try
        {
            // API-Endpoint muss die neuesten Rezepte liefern, z.B. /api/recipes/latest
            recipes = await Api.Http.GetFromJsonAsync<List<RecipeListItemDto>>("api/recipes/latest");
        }
        catch
        {
            recipes = null;
        }
    }

    private CreateRecipeDialog? createDialog;

    private void ToggleCreateMenu()
    {
        // statt eigener Menu-Logik: öffne Dialog
        createDialog?.Show();
    }

    private Task HandleCreateDialogClosed(CreateRecipeDialog.DialogResult result)
    {
        if (result.Success)
        {
            // bei Bedarf Liste neu laden oder UI anpassen
            _ = LoadLists();
        }
        return Task.CompletedTask;
    }

    private record RecipeListItemDto(string Id, string Title, string? ImageUrl);
    private record CreatedRecipeDto(string Id);
}
<style>
.recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
}
.recipe-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: box-shadow 0.2s;
    min-height: 260px;
}
.recipe-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.13);
}
.recipe-card img, .recipe-card .no-image {
    width: 100%;
    height: 160px;
    object-fit: cover;
    background: #f5f5f5;
    display: block;
}
.recipe-card .no-image {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: #bbb;
}
.recipe-title {
    padding: 1rem;
    font-weight: 600;
    font-size: 1.1rem;
    text-align: center;
    flex: 1 1 auto;
}

/* Create menu overlay */
.create-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
}
.create-menu {
    width: min(420px, 90%);
}

    /* Styles für das URL‑Import Overlay (scoped für CookbookPage) */

    .overlay-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .overlay-content {
        background: #fff;
        padding: 1.25rem;
        border-radius: 8px;
        max-width: 680px;
        width: min(100%, 680px);
        max-height: 80vh;
        overflow: auto;
        position: relative;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    }

    /* Close‑Button oben rechts */
    .overlay-close {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        z-index: 1;
    }

    /* Formular-Elemente im Overlay */
    .overlay-content .form-label {
        display: block;
        margin-bottom: 0.25rem;
        font-weight: 600;
    }

    .overlay-content .form-control {
        width: 100%;
        box-sizing: border-box;
    }

    /* Informations- / Fehlermeldung */
    .overlay-content .text-muted {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        color: #6c757d;
    }

    /* Buttons */
    .overlay-content .d-flex {
        margin-top: 0.75rem;
    }

    .overlay-content .btn + .btn {
        margin-left: 0.5rem;
    }

    /* Kleine Verbesserungen für mobile */
    @@media (max-width: 520px) {
        .overlay-content {
            padding: 0.75rem;
            max-height: 85vh;
        }

        .overlay-close {
            top: 0.25rem;
            right: 0.25rem;
        }
    }
</style>
