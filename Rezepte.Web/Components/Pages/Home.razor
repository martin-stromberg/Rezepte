@page "/"
@using Rezepte.Web.Components.Shared
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<UiStrings> Localizer

<PageTitle>Rezepte</PageTitle>

<h5 class="mb-3 d-flex align-items-center justify-content-between">
    <span></span>
    <div class="btn-group">
        <button class="btn btn-sm btn-outline-primary" @onclick="ToggleCreateMenu" title="@Localizer["CreateNewRecipe"]">
            <span>@Localizer["New"]</span>
        </button>
    </div>
</h5>

<ScheduledRecipes />

<RandomFromCookbooks/>

<LatestRecipes @ref="latestRecipes" />

<CreateRecipeDialog @ref="createDialog" OnClosed="HandleCreateDialogClosed" />

@code {
    private CreateRecipeDialog? createDialog;
    private LatestRecipes? latestRecipes;

    private void ToggleCreateMenu()
    {
        createDialog?.Show();
    }

    // Nach dem Erstellen neu laden via Component-Ref
    private async Task HandleCreateDialogClosed(CreateRecipeDialog.DialogResult result)
    {
        if (result.Success)
        {
            // refresh the latest recipes component
            if (latestRecipes is not null)
            {
                await latestRecipes.RefreshAsync();
            }
        }
    }
}
