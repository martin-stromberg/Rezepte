@page "/"
@inject ApiClient Api

<PageTitle>Rezepte</PageTitle>

<h2>Zuletzt hinzugefügte Rezepte</h2>

@if (isLoading)
{
    <div>Lade Rezepte…</div>
}
else if (recipes is null || recipes.Count == 0)
{
    <div class="alert alert-info">Noch keine Rezepte vorhanden.</div>
}
else
{
    <div class="recipe-grid">
        @foreach (var recipe in recipes)
        {
            <a class="recipe-card" href="@($"/recipes/{recipe.Id}")" title="@recipe.Title">
                @if (!string.IsNullOrWhiteSpace(recipe.ImageUrl))
                {
                    <img src="@recipe.ImageUrl" alt="Bild zu @recipe.Title" />
                }
                else
                {
                    <div class="no-image">📷</div>
                }
                <div class="recipe-title">@recipe.Title</div>
            </a>
        }
    </div>
}

@code {
    private List<RecipeListItemDto>? recipes;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            // API-Endpoint muss die neuesten Rezepte liefern, z.B. /api/recipes/latest
            recipes = await Api.Http.GetFromJsonAsync<List<RecipeListItemDto>>("api/recipes/latest");
        }
        catch
        {
            recipes = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private record RecipeListItemDto(string Id, string Title, string? ImageUrl);
}
<style>
.recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
}
.recipe-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: box-shadow 0.2s;
    min-height: 260px;
}
.recipe-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.13);
}
.recipe-card img, .recipe-card .no-image {
    width: 100%;
    height: 160px;
    object-fit: cover;
    background: #f5f5f5;
    display: block;
}
.recipe-card .no-image {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: #bbb;
}
.recipe-title {
    padding: 1rem;
    font-weight: 600;
    font-size: 1.1rem;
    text-align: center;
    flex: 1 1 auto;
}
</style>
