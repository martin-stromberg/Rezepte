@page "/recipes/{Id}/edit"
@page "/recipes/new"
@using Microsoft.AspNetCore.Authorization
@using Rezepte.Web.Components.Shared
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager Nav
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>@(title ?? "Rezept")</PageTitle>

<h5 class="mb-3 d-flex align-items-center justify-content-between">
    <span>@(IsNew ? "Neues Rezept" : "Rezept bearbeiten")</span>
    <div class="btn-group">
        <button class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@isBusy" title="Speichern">💾</button>
        <a class="btn btn-sm btn-outline-secondary" href="@CancelHref" title="Abbrechen">↩️</a>
        <button class="btn btn-sm btn-secondary" @onclick="ShowImagesOverlay" title="Bilder verwalten">
            <i class="bi bi-images"></i>
        </button>
        <button class="btn btn-sm btn-outline-danger" @onclick="DeleteAsync" disabled="@isBusy" title="Löschen">🗑️</button>
    </div>
</h5>

@if (isLoading)
{
    <div class="text-muted">Lade…</div>
}
else if (loadError)
{
    <div class="alert alert-danger">Rezept konnte nicht geladen werden.</div>
}
else
{
    if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Titel</label>
                <input class="form-control" @bind="title" />
            </div>
            <div class="mb-3">
                <label class="form-label">Beschreibung</label>
                <textarea class="form-control" rows="3" @bind="description"></textarea>
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-4 mb-3">
                    <label class="form-label">Portionen</label>
                    <input class="form-control" type="number" min="1" @bind="numberOfPortions" />
                </div>
                <div class="col-12 col-md-8 mb-3">
                    <label class="form-label">Quelle (URL)</label>
                    <input class="form-control" type="url" @bind="sourceUri" placeholder="https://..." />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h6>Beilagen</h6>
            <div class="input-group mb-2">
                <input class="form-control" placeholder="Rezept, Rezept-ID oder Rezept-URL als Beilage suchen..." @bind="sideDishSearchQuery" />
                <button type="button" class="btn btn-outline-secondary" @onclick="SearchSideDishesAsync" disabled="@isSearchingSideDishes">Suchen</button>
            </div>
            @if (sideDishSearchResults.Count > 0)
            {
                <div class="list-group mb-3">
                    @foreach (var result in sideDishSearchResults)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@result.Title</div>
                                @if (!string.IsNullOrWhiteSpace(result.Snippet))
                                {
                                    <div class="small text-muted">@result.Snippet</div>
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddSideDish(result)" disabled="@(!CanAddSideDish(result.Id))">Hinzufügen</button>
                        </div>
                    }
                </div>
            }
            @if (sideDishes.Count == 0)
            {
                <div class="text-muted small">Keine Beilagen hinterlegt.</div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var sideDish in sideDishes)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@sideDish.Title</span>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveSideDish(sideDish.Id)">Entfernen</button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="accordion" id="recipeStepsEdit">
        @for (var i = 0; i < steps.Count; i++)
        {
            var step = steps[i];
            var collapseId = $"estep{i}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="eheading@i">
                    <button class="accordion-button @(i == 0 ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                        Schritt @(i + 1): @(string.IsNullOrWhiteSpace(step.Title) ? "(ohne Titel)" : step.Title)
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : string.Empty)" data-bs-parent="#recipeStepsEdit">
                    <div class="accordion-body">
                        <div class="mb-3">
                            <label class="form-label">Titel (optional)</label>
                            <input class="form-control" @bind="step.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Beschreibung</label>
                            <textarea class="form-control" rows="3" @bind="step.Description"></textarea>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label">Zubereitungsdauer (Minuten)</label>
                                <input class="form-control" type="number" @bind-value="step.DurationMinutes" @bind-value:event="oninput" />
                            </div>
                            <div class="col-12 col-md-4 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="step.RequiresOvernightRest" id="eovernight@i" />
                                    <label class="form-check-label" for="eovernight@i">Ruhezeit über Nacht</label>
                                </div>
                            </div>
                        </div>

                        <h6>Zutaten</h6>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th style="width: 20%">Menge</th>
                                        <th style="width: 20%">Einheit</th>
                                        <th>Bezeichnung</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ing in step.Ingredients)
                                    {
                                        <tr>
                                            <td><input class="form-control" type="number" step="0.01" @bind-value="ing.Amount" @bind-value:event="oninput" /></td>
                                            <td><input class="form-control" @bind="ing.Unit" /></td>
                                            <td><input class="form-control" @bind="ing.Name" /></td>
                                        </tr>
                                    }
                                    <tr>
                                        <td colspan="3">
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="(() => AddIngredient(step))">Zutat hinzufügen</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-3">
        <button type="button" class="btn btn-outline-primary" @onclick="AddStep">Neuen Zubereitungsschritt hinzufügen</button>
    </div>
}

<PhotoOverlay Show="@showImagesOverlay"
              RezeptId="@Id"
              Mode="edit"
              OnClose="CloseImagesOverlay"
              OnShowLargeImage="ShowLargeImage" />

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] [SupplyParameterFromQuery] public string? CookbookId { get; set; }

    private bool IsNew => string.IsNullOrWhiteSpace(Id);
    private string CancelHref => IsNew
        ? (!string.IsNullOrWhiteSpace(CookbookId) ? $"/cookbooks/{CookbookId}" : "/cookbooks")
        : $"/recipes/{Id}";

    private bool isLoading = true;
    private bool isBusy;
    private bool loadError;
    private string errorMessage;

    private string title = string.Empty;
    private string? description;
    private List<StepModel> steps = new();

    private bool showImagesOverlay = false;
    private string? largeImageUrl;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; loadError = false; steps.Clear();
        if (IsNew)
        {
            // Create mode: ensure one editable initial step
            title = string.Empty;
            description = null;
            // sensible defaults for new recipe
            numberOfPortions = 1;
            sourceUri = null;
            sideDishes.Clear();
            sideDishSearchResults.Clear();
            steps.Add(new StepModel());
            isLoading = false;
            return;
        }

        try
        {
            var dto = await Api.Http.GetFromJsonAsync<RecipeDto>($"api/recipes/{Id}");
            if (dto is null) { loadError = true; return; }
            title = dto.Title;
            description = dto.Description;
            numberOfPortions = dto.NumberOfPortions;
            sourceUri = dto.sourceUri;
            sideDishes = (dto.SideDishes ?? new List<SideDishDto>()).Select(sd => new SideDishModel(sd.Id, sd.Title, sd.Description, sd.ImageUrl, sd.Portions)).ToList();
            foreach (var s in dto.Steps.OrderBy(s => s.StepIndex))
            {
                steps.Add(new StepModel
                {
                    Title = s.Title,
                    Description = s.Description,
                    DurationMinutes = s.DurationMinutes,
                    RequiresOvernightRest = s.RequiresOvernightRest,
                    Ingredients = s.Ingredients.Select(i => new IngredientModel
                    {
                        Amount = i.Amount,
                        Unit = i.Unit,
                        Name = i.Name
                    }).ToList()
                });
            }
            if (steps.Count == 0)
            {
                steps.Add(new StepModel());
            }
        }
        catch { loadError = true; }
        finally { isLoading = false; }
    }

    private void AddStep()
    {
        steps.Add(new StepModel());
    }

    private void AddIngredient(StepModel step)
    {
        step.Ingredients.Add(new IngredientModel());
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (IsNew)
        {
            var createPayload = new
            {
                cookbookId = string.IsNullOrEmpty(CookbookId) ? null : CookbookId,
                title,
                description,
                uri = string.IsNullOrWhiteSpace(sourceUri) ? null : sourceUri,
                portions = numberOfPortions,
                sideDishRecipeIds = sideDishes.Select(sd => sd.Id).ToList(),
                steps = steps.Select(s => new
                {
                    title = string.IsNullOrWhiteSpace(s.Title) ? null : s.Title,
                    description = s.Description,
                    durationMinutes = s.DurationMinutes,
                    requiresOvernightRest = s.RequiresOvernightRest,
                    ingredients = s.Ingredients.Select(i => new { amount = i.Amount, unit = i.Unit, name = i.Name }).ToList()
                }).ToList()
            };
            isBusy = true;
            try
            {
                var res = await Api.Http.PostAsJsonAsync("api/recipes", createPayload);
                if (res.IsSuccessStatusCode)
                {
                    var obj = await res.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                    if (obj is not null && obj.TryGetValue("id", out var id))
                    {
                        // Force full navigation to ensure the Router renders the view page
                        Nav.NavigateTo($"/recipes/{id}", forceLoad: true);
                    }
                }
                else
                {
                    errorMessage = await res.Content.ReadAsStringAsync();
                }
            }
            finally { isBusy = false; }
        }
        else
        {
            var updatePayload = new
            {
                title,
                description,
                uri = string.IsNullOrWhiteSpace(sourceUri) ? null : sourceUri,
                portions = numberOfPortions,
                sideDishRecipeIds = sideDishes.Select(sd => sd.Id).ToList(),
                steps = steps.Select(s => new
                {
                    title = string.IsNullOrWhiteSpace(s.Title) ? null : s.Title,
                    description = s.Description,
                    durationMinutes = s.DurationMinutes,
                    requiresOvernightRest = s.RequiresOvernightRest,
                    ingredients = s.Ingredients.Select(i => new { amount = i.Amount, unit = i.Unit, name = i.Name }).ToList()
                }).ToList()
            };
            isBusy = true;
            try
            {
                var res = await Api.Http.PutAsJsonAsync($"api/recipes/{Id}", updatePayload);
                if (res.IsSuccessStatusCode)
                {
                    // Force full navigation so the RecipePage is shown instead of the edit form
                    Nav.NavigateTo($"/recipes/{Id}", forceLoad: true);
                }
            }
            finally { isBusy = false; }
        }
    }
    private async Task DeleteAsync()
    {
        if (IsNew)
        {
            Nav.NavigateTo("/");
            return;
        }

        // Bestätigungsabfrage vor dem Löschen
        var ok = await JS.InvokeAsync<bool>("confirm", "Soll das Rezept komplett gelöscht werden?. Diese Aktion kann nicht rückgängig gemacht werden.");
        if (!ok) return;

        isBusy = true;
        try
        {
            var res = await Api.Http.DeleteAsync($"api/recipes/{Id}");
            if (!res.IsSuccessStatusCode) { return; }
            Nav.NavigateTo("/");
        }
        catch { }
        finally { isBusy = false; }
    }

    private void ShowImagesOverlay()
    {
        showImagesOverlay = true;
        StateHasChanged();
    }

    private void CloseImagesOverlay()
    {
        showImagesOverlay = false;
    }

    private void ShowLargeImage(string url)
    {
        largeImageUrl = url;
    }

    private async Task SearchSideDishesAsync()
    {
        var q = sideDishSearchQuery?.Trim();
        sideDishSearchResults.Clear();
        if (string.IsNullOrWhiteSpace(q)) return;

        isSearchingSideDishes = true;
        try
        {
            var exactRecipeId = ExtractRecipeId(q);
            if (!string.IsNullOrWhiteSpace(exactRecipeId))
            {
                var exactMatch = await LoadRecipeSearchResultByIdAsync(exactRecipeId);
                if (exactMatch is not null && CanAddSideDish(exactMatch.Id))
                {
                    sideDishSearchResults.Add(exactMatch);
                }

                return;
            }

            var url = $"api/recipes/search?q={Uri.EscapeDataString(q)}&page=1&pageSize=10";
            var response = await Api.Http.GetFromJsonAsync<RecipeSearchResponseDto>(url);
            sideDishSearchResults = response?.Items?
                .Where(item => CanAddSideDish(item.Id))
                .ToList() ?? new List<RecipeSearchResultDto>();
        }
        finally
        {
            isSearchingSideDishes = false;
        }
    }

    private async Task<RecipeSearchResultDto?> LoadRecipeSearchResultByIdAsync(string recipeId)
    {
        try
        {
            var dto = await Api.Http.GetFromJsonAsync<RecipeDto>($"api/recipes/{Uri.EscapeDataString(recipeId)}");
            return dto is null
                ? null
                : new RecipeSearchResultDto(dto.Id, dto.Title, dto.Description, dto.ImageUrl, dto.NumberOfPortions);
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

    private static string? ExtractRecipeId(string value)
    {
        var trimmed = value.Trim();
        if (IsRecipeId(trimmed)) return trimmed;

        if (Uri.TryCreate(trimmed, UriKind.Absolute, out var uri))
        {
            var segments = uri.AbsolutePath
                .Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            for (var i = 0; i < segments.Length - 1; i++)
            {
                if (string.Equals(segments[i], "recipes", StringComparison.OrdinalIgnoreCase)
                    && IsRecipeId(segments[i + 1]))
                {
                    return segments[i + 1];
                }
            }
        }

        return null;
    }

    private static bool IsRecipeId(string value)
    {
        return value.Length is >= 8 and <= 64 && value.All(Uri.IsHexDigit);
    }

    private bool CanAddSideDish(string id)
    {
        return !string.IsNullOrWhiteSpace(id)
            && (IsNew || !string.Equals(id, Id, StringComparison.Ordinal))
            && !sideDishes.Any(sd => string.Equals(sd.Id, id, StringComparison.Ordinal));
    }

    private void AddSideDish(RecipeSearchResultDto result)
    {
        if (!CanAddSideDish(result.Id)) return;
        sideDishes.Add(new SideDishModel(result.Id, result.Title, result.Snippet, result.PrimaryImageUrl, result.DefaultPortions ?? 0));
        sideDishSearchResults.RemoveAll(r => r.Id == result.Id);
    }

    private void RemoveSideDish(string id)
    {
        sideDishes.RemoveAll(sd => sd.Id == id);
    }

    private record RecipeDto(string Id, string CookbookId, string Title, string? Description, int NumberOfPortions, List<RecipeStepDto> Steps, string? ImageUrl = null, string? sourceUri = null, List<SideDishDto>? SideDishes = null);
    private record RecipeStepDto(string Id, int StepIndex, string? Title, string Description, int DurationMinutes, bool RequiresOvernightRest, List<RecipeIngredientDto> Ingredients);
    private record RecipeIngredientDto(string Id, decimal Amount, string? Unit, string Name);
    private record SideDishDto(string Id, string Title, string? Description, string? ImageUrl, int Portions);
    private record SideDishModel(string Id, string Title, string? Description, string? ImageUrl, int Portions);
    private record RecipeSearchResponseDto(List<RecipeSearchResultDto> Items, int Total);
    private record RecipeSearchResultDto(string Id, string Title, string? Snippet, string? PrimaryImageUrl, int? DefaultPortions);

    private class StepModel
    {
        public string? Title { get; set; }
        public string Description { get; set; } = string.Empty;
        public int DurationMinutes { get; set; }
        public bool RequiresOvernightRest { get; set; }
        public List<IngredientModel> Ingredients { get; set; } = new();
    }

    private class IngredientModel
    {
        public decimal Amount { get; set; }
        public string? Unit { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    // new fields for editable properties
    private int numberOfPortions;
    private string? sourceUri;
    private string sideDishSearchQuery = string.Empty;
    private bool isSearchingSideDishes;
    private List<SideDishModel> sideDishes = new();
    private List<RecipeSearchResultDto> sideDishSearchResults = new();
}


<style>
    .overlay-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.6);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .overlay-content {
        background: #fff;
        padding: 1.5rem;
        border-radius: 8px;
        max-width: 90vw;
        max-height: 90vh;
        overflow: auto;
        position: relative;
    }

    .overlay-close {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
    }

    .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 1rem;
        width: 100%;
    }

    .thumb {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        cursor: pointer;
        border-radius: 4px;
        border: 1px solid #ddd;
        transition: box-shadow 0.2s;
    }

        .thumb:hover {
            box-shadow: 0 0 0 2px #007bff;
        }

    .overlay-large {
        max-width: 95vw;
        max-height: 95vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .large-img {
        max-width: 90vw;
        max-height: 80vh;
        border-radius: 8px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.3);
    }
</style>
