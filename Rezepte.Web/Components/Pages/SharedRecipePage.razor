@page "/share/{Token}"
@page "/share/{Token}/sidedish/{RecipeId}"
@layout PublicLayout
@using Microsoft.AspNetCore.Components.Web
@using Rezepte.Web.Components.Layout
@using Rezepte.Web.Services
@inject IRecipeShareService ShareService
@inject IStringLocalizer<UiStrings> Localizer

<PageTitle>@(view?.Title ?? "Rezepte")</PageTitle>

@if (isLoading)
{
    <div class="text-muted">@Localizer["Loading"]</div>
}
else if (view is null)
{
    <div class="alert alert-warning" role="alert">@Localizer["SharedRecipeNotFound"]</div>
}
else
{
    <div class="row mb-3 g-3 align-items-start">
        <div class="col-12 col-md-6">
            @if (view.ImageUrls.Count > 0)
            {
                <div class="rounded shadow-sm bg-light w-100" style="aspect-ratio: 4/3; overflow: hidden;">
                    <img src="@view.ImageUrls[0]" alt="@Localizer["RecipePhoto"]" class="img-fluid w-100 h-100" style="object-fit: cover;" />
                </div>
                @if (view.ImageUrls.Count > 1)
                {
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var url in view.ImageUrls.Skip(1))
                        {
                            <img src="@url" alt="@Localizer["RecipePhoto"]" class="rounded" style="width: 96px; height: 72px; object-fit: cover;" />
                        }
                    </div>
                }
            }
        </div>
        <div class="col-12 col-md-6">
            <h1 class="h4 mb-1">@view.Title</h1>
            @if (!string.IsNullOrWhiteSpace(view.Description))
                foreach (var line in view.Description.Split("\r\n"))
                {
                    <div class="mb-2 text-muted">@line</div>
                }
            <div class="d-flex flex-wrap gap-3 align-items-center small text-secondary mb-2">
                @if (TotalMinutes > 0)
                {
                    <span><i class="bi bi-clock"></i> @Localizer["SharedRecipeTotal"]: @TotalMinutes min</span>
                }
                @if (RestNights > 0)
                {
                    <span><i class="bi bi-moon"></i> @Localizer["SharedRecipeRestNights"]: @RestNights</span>
                }
            </div>
            @if (view.Portions > 0)
            {
                <div class="d-flex flex-wrap gap-3 align-items-center small text-secondary mb-2">
                    <span><i class="bi bi-people-fill"></i> @Localizer["SharedRecipePortions"]: @view.Portions</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(view.SourceUri))
            {
                <div class="mb-2">
                    <a href="@view.SourceUri" target="_blank" rel="noopener noreferrer">@Localizer["SharedRecipeSource"]</a>
                </div>
            }
            @if (view.SideDishes.Count > 0)
            {
                <div class="mt-3">
                    <div class="fw-semibold small text-secondary mb-2">@Localizer["SharedRecipeSideDishes"]</div>
                    <div class="list-group">
                        @foreach (var sideDish in view.SideDishes)
                        {
                            <a class="list-group-item list-group-item-action" href="@sideDish.Url">@sideDish.Title</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="accordion" id="sharedSteps">
        @for (var i = 0; i < view.Steps.Count; i++)
        {
            var s = view.Steps[i];
            var collapseId = $"shared-step{i}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="shared-heading@i">
                    <button class="accordion-button @(i == 0 ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                        @Localizer["SharedRecipeStep"] @(i + 1): @(string.IsNullOrWhiteSpace(s.Title) ? Localizer["SharedRecipeStepUntitled"].Value : s.Title) · @s.DurationMinutes min @(s.RequiresOvernightRest ? "· " + Localizer["OvernightRest"].Value : string.Empty)
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : string.Empty)" data-bs-parent="#sharedSteps">
                    <div class="accordion-body">
                        @foreach (var line in s.Description.Split("\r\n"))
                        {
                            <div class="mb-2">@line</div>
                        }

                        @if (s.Ingredients?.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th style="width: 20%">@Localizer["Amount"]</th>
                                            <th style="width: 20%">@Localizer["Unit"]</th>
                                            <th>@Localizer["Ingredient"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ing in s.Ingredients)
                                        {
                                            <tr>
                                                <td>@ing.Amount</td>
                                                <td>@ing.Unit</td>
                                                <td>@ing.Name</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Token { get; set; } = string.Empty;
    [Parameter] public string? RecipeId { get; set; }

    private SharedRecipeView? view;
    private bool isLoading = true;

    private int TotalMinutes => view?.Steps.Sum(s => s.DurationMinutes) ?? 0;
    private int RestNights => view?.Steps.Count(s => s.RequiresOvernightRest) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(RecipeId))
        {
            view = await ShareService.GetSharedSideDishAsync(Token, RecipeId);
        }
        else
        {
            view = await ShareService.GetSharedRecipeAsync(Token);
        }

        isLoading = false;
    }
}
