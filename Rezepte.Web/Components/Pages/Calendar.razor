@page "/calendar"
@using System.Net.Http.Json
@using Rezepte.Web.Entities
@using Microsoft.AspNetCore.Components.Forms
@using Rezepte.Web.Components.Shared
@using Rezepte.Web.Models
@using static Rezepte.Web.Components.Shared.CalendarEventDialog
@rendermode InteractiveServer
@inject ApiClient Client
@inject NavigationManager Nav

<PageTitle>Mein Kalender</PageTitle>

<h3>Kalender</h3>

<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-primary" @onclick="ShowCreate">Termin erstellen</button>
</div>

@if (isLoading)
{
    <div>lade…</div>
}
else
{
    <div class="list-group">
        @foreach (var occ in occurrences)
        {
            <div class="list-group-item d-flex justify-content-between align-items-start">
                <div>
                    <div class="fw-semibold">@occ.Occurrence.ToLocalTime()</div>
                    <div class="text-muted">@occ.Title (@occ.Portions)</div>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(occ.EventId)">Bearbeiten</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Delete(occ.EventId)">Löschen</button>
                </div>
            </div>
        }
    </div>
}

@* ausgelagerter Dialog für Create/Edit *@
@if (showForm)
{
    <!-- Dialog jetzt als Modal zentriert anzeigen -->
    <CalendarEventDialog Modal="true"
                         EditingId="@editingId"
                         InitialEvent="@editingEvent"
                         OnSaved="OnDialogSaved"
                         OnCancel="OnDialogCanceled" />
}

@code {
    // Erweiterte OccurrenceView mit allen nötigen Informationen für Editing
    private record OccurrenceView(string EventId, string? RecipeId, DateTime Occurrence, TimeSpan TimeOfDay, string Title, int Portions, RecurrenceType Recurrence, WeekDays RecurrenceDays);

    private List<OccurrenceView> occurrences = new();
    private bool isLoading = true;
    private bool showForm;
    private string? editingId;
    private CalendarEventDto? editingEvent;

    private Dictionary<WeekDays, bool> bindWeekDays = Enum.GetValues(typeof(WeekDays)).Cast<WeekDays>().Where(w => w != WeekDays.None).ToDictionary(w => (WeekDays)w, _ => false);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        occurrences.Clear();
        var from = DateTime.UtcNow.Date.AddDays(-1);
        var to = DateTime.UtcNow.Date.AddDays(30);
        var resp = await Client.Http.GetFromJsonAsync<ApiCalendarResponse>($"/api/calendar?from={from:o}&to={to:o}");
        if (resp?.items != null)
        {
            foreach (var it in resp.items)
            {
                var title = string.IsNullOrWhiteSpace(it.recipeId) ? "Termin" : "Rezept";
                occurrences.Add(new OccurrenceView(
                    it.id,
                    it.recipeId,
                    it.occurrence,
                    it.occurrence.TimeOfDay,
                    title,
                    (int)it.portions,
                    it.recurrence,
                    it.recurrenceDays));
            }
        }
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowCreate()
    {
        editingId = null;
        editingEvent = null;
        showForm = true;
        foreach (var k in bindWeekDays.Keys.ToList()) bindWeekDays[k] = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Edit(string eventId)
    {
        editingId = eventId;
        // find loaded occurrence and pass as InitialEvent into dialog
        var occ = occurrences.FirstOrDefault(o => o.EventId == eventId);
        if (occ != null)
        {
            editingEvent = new CalendarEventDto(
                occ.EventId,
                occ.RecipeId,
                occ.Occurrence.Date,
                occ.TimeOfDay,
                occ.Portions,
                occ.Recurrence,
                occ.RecurrenceDays);
        }
        else
        {
            editingEvent = null;
        }
        showForm = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Delete(string eventId)
    {
        await Client.Http.DeleteAsync($"/api/calendar/{eventId}");
        await LoadAsync();
    }

    private async Task OnDialogSaved()
    {
        showForm = false;
        await LoadAsync();
    }

    private Task OnDialogCanceled()
    {
        showForm = false;
        return Task.CompletedTask;
    }

    // DTOs for client JSON handling: occurrence is DateTime, not string
    private record ApiCalendarResponseItem(String id, String? recipeId, DateTime occurrence, Int32 portions, RecurrenceType recurrence, WeekDays recurrenceDays);
    private record ApiCalendarResponse(ApiCalendarResponseItem[]? items);
}