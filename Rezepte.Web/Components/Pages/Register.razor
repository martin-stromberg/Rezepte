@page "/register"
@inject NavigationManager Nav
@inject IStringLocalizer<UiStrings> Localizer
@using Microsoft.AspNetCore.Components

<PageTitle>@Localizer["RegisterPageTitle"]</PageTitle>

<div class="page-auth my-5">
    <div class="card shadow-soft">
        <div class="card-header"><h3 class="mb-0">Registrieren</h3></div>
        <div class="card-body p-4">
            <!-- Browser-posting form: values are sent through name attributes directly to the API endpoint. -->
            <EditForm Model="model" Action="api/auth/register" Method="post" FormName="register">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label" for="register-username">Benutzername</label>
                    <InputText id="register-username" class="form-control" @bind-Value="model.Username" @bind-Value:event="oninput" name="Username" autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="register-email">@Localizer["EmailOptional"]</label>
                    <InputText id="register-email" class="form-control" @bind-Value="model.Email" @bind-Value:event="oninput" name="Email" autocomplete="email" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="register-password">Passwort</label>
                    <InputText id="register-password" class="form-control" @bind-Value="model.Password" @bind-Value:event="oninput" type="password" name="Password" autocomplete="new-password" />
                </div>
                <div class="mb-3 form-check">
                    <InputCheckbox id="register-create-demo-data" class="form-check-input" @bind-Value="model.CreateDemoData" name="createDemoData" />
                    <label class="form-check-label" for="register-create-demo-data">@Localizer["CreateDemoData"]</label>
                    <small class="form-text text-muted d-block">@Localizer["CreateDemoDataHelp"]</small>
                </div>
                <div class="d-grid">
                    <button class="btn btn-accent" type="submit">Registrieren</button>
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert alert-danger mt-3" role="alert">@Error</div>
            }
        </div>
    </div>
</div>

@code {
    private RegisterModel model = new();

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private class RegisterModel
    {
        public string Username { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string Password { get; set; } = string.Empty;
        public bool CreateDemoData { get; set; }
    }
}
