<!DOCTYPE html>
<html lang="de">

@using Microsoft.AspNetCore.Components.Authorization

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/icons/rezepte_64x64.ico" />
    <link ref="apple-touch-icon" href="/icons/rezepte-180x180.png">
    <link rel="manifest" href="/manifest.json">
    <!-- Bootstrap CSS zuerst laden -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- App-Styles nach Bootstrap, damit wir überschreiben können -->
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <!-- Komponenten-spezifische Styles -->
    <link rel="stylesheet" href="@Assets["Rezepte.Web.styles.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <script src="js/fileDownload.js"></script>
    <script src="js/dragHelpers.js"></script>
    <script src="js/backupRestore.js"></script>
    <script src="js/randomFromCookbooks.js"></script>
    <!-- Füge im <head> die Cropper.css hinzu -->
    <link href="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.css" rel="stylesheet" />

    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <!-- Vor dem Blazor-Script (z.B. ganz unten im body) -->
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.js"></script>
    <script src="js/imageCropper.js"></script>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/loadingBar.js"></script>
    <!-- Optional: Bootstrap Bundle für interaktive Komponenten -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <!-- Auth Hilfsfunktionen für Cookie-Login per Fetch -->
    <script src="js/auth.js"></script>
    <script>
        window.triggerFileInput = (element) => {
            if (element) {
                element.click();
            }
        };
    </script>
</body>

</html>
