<!DOCTYPE html>
<html lang="de">

@using Microsoft.AspNetCore.Components.Authorization

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="icons/rezepte.ico" />
    <!-- Bootstrap CSS zuerst laden -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- App-Styles nach Bootstrap, damit wir überschreiben können -->
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <!-- Komponenten-spezifische Styles -->
    <link rel="stylesheet" href="@Assets["Rezepte.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <script src="_framework/blazor.web.js"></script>
    <!-- Optional: Bootstrap Bundle für interaktive Komponenten -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <!-- Auth Hilfsfunktionen für Cookie-Login per Fetch -->
    <script src="js/auth.js"></script>
</body>

</html>
