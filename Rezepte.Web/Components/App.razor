<!DOCTYPE html>
<html lang="de">

@using Microsoft.AspNetCore.Components.Authorization

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/icons/rezepte_64x64.ico" />
    <link ref="apple-touch-icon" href="/icons/rezepte-180x180.png">
    <link rel="manifest" href="/manifest.json">
    <!-- Bootstrap CSS zuerst laden -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- App-Styles nach Bootstrap, damit wir überschreiben können -->
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <!-- Komponenten-spezifische Styles -->
    <link rel="stylesheet" href="@Assets["Rezepte.Web.styles.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <script src="js/fileDownload.js"></script>
    <script src="js/dragHelpers.js"></script>
    <script src="js/backupRestore.js"></script>
    <script src="js/randomFromCookbooks.js"></script>
    <!-- Füge im <head> die Cropper.css hinzu -->
    <link href="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.css" rel="stylesheet" />

    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <!-- Vor dem Blazor-Script (z.B. ganz unten im body) -->
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.js"></script>
    <script src="js/imageCropper.js"></script>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/loadingBar.js"></script>
    <!-- Optional: Bootstrap Bundle für interaktive Komponenten -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <!-- Auth Hilfsfunktionen für Cookie-Login per Fetch -->
    <script src="js/auth.js"></script>
    <script>
        window.triggerFileInput = (element) => {
            if (element) {
                element.click();
            }
        };
        // Snapshots the live value of the recipe search input on every input
        // event. The delegated listener runs in plain JS and therefore works
        // before the interactive circuit exists - text typed into the
        // prerendered DOM is otherwise known to nobody, because the server only
        // learns the query from the URL. The snapshot carries the URL it was
        // typed on so a navigation cannot restore a stale value into the next
        // page's field.
        document.addEventListener('input', (event) => {
            if (event.target && event.target.id === 'search-q') {
                window.rezepteTypedSearchValue = { url: location.href, value: event.target.value };
            }
        }, true);
        // After-first-render sync for the search input, called from
        // RecipeSearch.OnAfterRenderAsync. The first call in a document marks
        // the circuit attach: a typed snapshot restores the user's text over
        // whatever the attach did to the element (value write or element
        // replacement) and is consumed so later mounts never see stale text.
        // Subsequent calls belong to remounts and only fill a still-empty
        // element with the current query - a field already showing the query
        // or user text is never touched.
        window.rezepteSyncSearchInput = (id, query) => {
            const el = document.getElementById(id);
            if (!el) {
                return;
            }
            if (!window.rezepteSearchAttachSynced) {
                window.rezepteSearchAttachSynced = true;
                const snapshot = window.rezepteTypedSearchValue;
                delete window.rezepteTypedSearchValue;
                if (snapshot && snapshot.url === location.href) {
                    el.value = snapshot.value;
                    return;
                }
            }
            if (el.value === '') {
                el.value = query;
            }
        };
    </script>
</body>

</html>
