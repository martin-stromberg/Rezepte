@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject Rezepte.Web.ViewModels.UserAdminViewModel Vm
@inject IStringLocalizer<UiStrings> Localizer

<h6 class="mb-3">Benutzerverwaltung</h6>

@if (Vm.IsLoading)
{
    <div class="text-muted">@Localizer["LoadingUsers"]</div>
}
else
{
    @if (!string.IsNullOrEmpty(Vm.Message))
    {
        <div class="alert @(Vm.IsError ? "alert-danger" : "alert-success")">@Vm.Message</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="input-group w-auto">
            <span class="input-group-text">🔎</span>
            <input class="form-control" placeholder="@Localizer["SearchPlaceholder"]" @bind="Vm.Query" />
        </div>
        <div class="card p-2">
            <div class="d-flex align-items-end gap-2">
                <input class="form-control" style="width: 12rem" placeholder="@Localizer["Username"]" @bind="Vm.NewUser.Username" />
                <input class="form-control" style="width: 14rem" placeholder="@Localizer["EmailOptional"]" @bind="Vm.NewUser.Email" />
                <input class="form-control" style="width: 12rem" placeholder="@Localizer["Password"]" type="password" @bind="Vm.NewUser.Password" />
                <div class="form-check ms-2">
                    <input class="form-check-input" type="checkbox" id="nuAdmin" @bind="Vm.NewUser.IsAdmin" />
                    <label class="form-check-label" for="nuAdmin">Admin</label>
                </div>
                <button class="btn btn-sm btn-success" @onclick="(() => Vm.CreateAsync())" disabled="@Vm.IsBusy">@Localizer["Create"]</button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Benutzername</th>
                    <th>E-Mail</th>
                    <th>Admin</th>
                    <th class="text-end">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Vm.Filtered)
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        <td>
                            <input type="checkbox" class="form-check-input" @bind="u.IsAdmin" />
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => Vm.SaveAsync(u)" disabled="@Vm.IsBusy">Speichern</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Vm.DeleteAsync(u)" disabled="@Vm.IsBusy">Löschen</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Vm.OnChange += StateHasChanged;
        await Vm.LoadAsync();
    }

    public void Dispose()
    {
        Vm.OnChange -= StateHasChanged;
    }
}
