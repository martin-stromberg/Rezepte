@using Rezepte.Web.Dto
@inject ApiClient Client
@inject IStringLocalizer<UiStrings> Localizer
@code {
    private UserStatsDto? stats;
    protected override async Task OnInitializedAsync()
    {
        stats = await Client.GetAsync<UserStatsDto>("api/userstats/me");
    }
}

@if (stats == null)
{
    <div>Lade…</div>
}
else
{
    <dl class="row">
        <dt class="col-6">@Localizer["TimeSinceRegistration"]</dt><dd class="col-6">@stats.TimeSinceRegistration</dd>
        <dt class="col-6">@Localizer["CookbookCount"]</dt><dd class="col-6">@stats.CookbookCount</dd>
        <dt class="col-6">@Localizer["OwnRecipes"]</dt><dd class="col-6">@stats.OwnRecipeCount</dd>
        <dt class="col-6">KI‑Anfragen</dt><dd class="col-6">@stats.AiRequestCount</dd>
    </dl>
}