@using Rezepte.Web.Services.Import.Plugins
@inject IPluginSettingsService PluginSettingsService
@inject IStringLocalizer<UiStrings> Localizer

@if (isLoading)
{
    <div>@Localizer["Loading"]</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageClass">@message</div>
    }

    <section class="mb-4">
        <h3 class="h6">@Localizer["GitHubPluginSources"]</h3>
        <div class="text-muted small mb-2">@Localizer["PluginSourcesInfo"]</div>
        <EditForm Model="sourceForm" OnValidSubmit="SaveSourceAsync">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-lg-5">
                    <label class="form-label small" for="plugin-source-url">@Localizer["RepositoryUrl"]</label>
                    <InputText id="plugin-source-url" class="form-control form-control-sm" @bind-Value="sourceForm.RepositoryUrl" />
                </div>
                <div class="col-6 col-lg-2">
                    <div class="form-check">
                        <InputCheckbox id="plugin-source-private" class="form-check-input" @bind-Value="sourceForm.IsPrivate" />
                        <label class="form-check-label small" for="plugin-source-private">@Localizer["Private"]</label>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="form-check">
                        <InputCheckbox id="plugin-source-enabled" class="form-check-input" @bind-Value="sourceForm.Enabled" />
                        <label class="form-check-label small" for="plugin-source-enabled">@Localizer["Active"]</label>
                    </div>
                </div>
                <div class="col-12 col-lg-3">
                    <label class="form-label small" for="plugin-source-pat">@Localizer["UpdatePat"]</label>
                    <InputText id="plugin-source-pat" type="password" class="form-control form-control-sm" @bind-Value="sourceForm.PersonalAccessToken" autocomplete="off" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <InputCheckbox id="plugin-source-trust" class="form-check-input" @bind-Value="sourceForm.TrustConfirmed" disabled="@(!string.IsNullOrWhiteSpace(sourceForm.Id))" />
                        <label class="form-check-label small" for="plugin-source-trust">@Localizer["TrustThisSource"]</label>
                    </div>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary btn-sm" type="submit" disabled="@isSaving">@Localizer["Save"]</button>
                    @if (!string.IsNullOrWhiteSpace(sourceForm.Id))
                    {
                        <button class="btn btn-outline-secondary btn-sm ms-2" type="button" disabled="@isSaving" @onclick="ResetSourceForm">@Localizer["Cancel"]</button>
                    }
                </div>
            </div>
        </EditForm>

        @if (sources.Count == 0)
        {
            <div class="text-muted small mt-3">@Localizer["NoGitHubPluginSources"]</div>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th style="width: 72px;">@Localizer["Active"]</th>
                            <th>@Localizer["Source"]</th>
                            <th>@Localizer["Status"]</th>
                            <th class="text-end" style="width: 160px;">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var source in sources)
                        {
                            <tr>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               checked="@source.Enabled"
                                               disabled="@(isSaving || checkingSourceId is not null)"
                                               aria-label="@Localizer["EnableSourceFor", source.RepositoryUrl]"
                                               @onchange="args => SetSourceEnabledAsync(source.Id, args)" />
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@source.Owner/@source.Repository</div>
                                    <div class="small text-muted">@source.RepositoryUrl</div>
                                    <div class="small">@(source.IsPrivate ? Localizer["Private"].Value : Localizer["Public"].Value) · @(source.HasSecret ? Localizer["SecretStored"].Value : Localizer["SecretMissing"].Value)</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(source.LastSuccessfulReleaseTag))
                                    {
                                        <span class="badge text-bg-success">@source.LastSuccessfulReleaseTag</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(source.LastError))
                                    {
                                        <div class="small text-danger">@source.LastError</div>
                                    }
                                    @if (source.LastErrorAt is not null)
                                    {
                                        <div class="small text-muted">@Localizer["SourceLastErrorAt", source.LastErrorAt.Value.ToLocalTime().ToString("g")]</div>
                                    }
                                    @if (source.LastCheckedAt is not null)
                                    {
                                        <div class="small text-muted">@Localizer["SourceLastCheckedAt", source.LastCheckedAt.Value.ToLocalTime().ToString("g")]</div>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="@Localizer["Actions"]">
                                        <span class="d-inline-block" title="@CheckButtonTitle(source)">
                                            <button class="btn btn-outline-secondary"
                                                    type="button"
                                                    title="@CheckButtonTitle(source)"
                                                    aria-label="@CheckButtonTitle(source)"
                                                    disabled="@(isSaving || checkingSourceId is not null || !source.Enabled || !source.TrustConfirmed)"
                                                    @onclick="() => CheckSourceAsync(source)">
                                                @if (checkingSourceId == source.Id)
                                                {
                                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                                }
                                            </button>
                                        </span>
                                        <span class="d-inline-block" title="@EditButtonTitle()">
                                            <button class="btn btn-outline-secondary"
                                                    type="button"
                                                    title="@EditButtonTitle()"
                                                    aria-label="@EditButtonTitle()"
                                                    disabled="@(isSaving || checkingSourceId is not null)"
                                                    @onclick="() => EditSource(source)">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </button>
                                        </span>
                                        <span class="d-inline-block" title="@DeleteButtonTitle()">
                                            <button class="btn btn-outline-danger"
                                                    type="button"
                                                    title="@DeleteButtonTitle()"
                                                    aria-label="@DeleteButtonTitle()"
                                                    disabled="@(isSaving || checkingSourceId is not null)"
                                                    @onclick="() => DeleteSourceAsync(source.Id)">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (plugins.Count == 0)
    {
        <div class="text-muted">@Localizer["NoImportPluginsFound"]</div>
    }
    else
    {
    <h3 class="h6">@Localizer["LocalImportPlugins"]</h3>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width: 72px;">@Localizer["Active"]</th>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Assembly"]</th>
                    <th class="text-end" style="width: 160px;">@Localizer["PluginOrder"]</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < plugins.Count; i++)
                {
                    var plugin = plugins[i];
                    <tr>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@plugin.Enabled"
                                       disabled="@isSaving"
                                       aria-label="@Localizer["EnablePluginFor", plugin.DisplayName]"
                                       @onchange="args => SetEnabledAsync(plugin.PluginId, args)" />
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">@plugin.DisplayName</div>
                            <div class="small text-muted">@plugin.PluginId</div>
                            @if (!string.IsNullOrWhiteSpace(plugin.Description))
                            {
                                <div class="small">@plugin.Description</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(plugin.Error))
                            {
                                <div class="small text-danger">@plugin.Error</div>
                            }
                        </td>
                        <td>
                            <span class="@StatusClass(plugin.Status)">@plugin.Status</span>
                            @if (plugin.Usability is { IsUsable: false } usability)
                            {
                                <span class="badge text-bg-warning ms-1">@Localizer["NotUsable"]</span>
                                <div class="mt-1">
                                    @foreach (var issue in usability.Issues)
                                    {
                                        <div class="small text-danger">@issue.Message</div>
                                        @if (!string.IsNullOrWhiteSpace(issue.Hint))
                                        {
                                            <div class="small text-muted">@issue.Hint</div>
                                        }
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            <div class="small">@plugin.AssemblyName</div>
                            <div class="small text-muted">@plugin.TypeName</div>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group" aria-label="@Localizer["PluginOrder"]">
                                <button class="btn btn-outline-secondary" title="@Localizer["MoveUp"]" aria-label="@Localizer["MoveUp"]" disabled="@(isSaving || i == 0)" @onclick="() => MoveAsync(plugin.PluginId, -1)">↑</button>
                                <button class="btn btn-outline-secondary" title="@Localizer["MoveDown"]" aria-label="@Localizer["MoveDown"]" disabled="@(isSaving || i == plugins.Count - 1)" @onclick="() => MoveAsync(plugin.PluginId, 1)">↓</button>
                            </div>
                            @if (plugin.Status == PluginStatus.Missing)
                            {
                                <span class="d-inline-block ms-1" title="@RemoveButtonTitle(plugin)">
                                    <button class="btn btn-outline-danger"
                                            type="button"
                                            title="@RemoveButtonTitle(plugin)"
                                            aria-label="@RemoveButtonTitle(plugin)"
                                            disabled="@isSaving"
                                            @onclick="() => RemovePluginEntryAsync(plugin)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
}

@code {
    private List<PluginSettingsItem> plugins = [];
    private List<PluginSourceSettingsItem> sources = [];
    private SourceForm sourceForm = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? checkingSourceId;
    private string? message;
    private string messageClass = "alert alert-danger py-2";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        message = null;
        try
        {
            plugins = (await PluginSettingsService.GetPluginsAsync()).ToList();
            await ReloadSourcesAsync();
        }
        catch (Exception ex)
        {
            message = Localizer["PluginsLoadFailed", ex.Message];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReloadSourcesAsync()
    {
        sources = (await PluginSettingsService.GetSourcesAsync()).ToList();
    }

    private async Task CheckSourceAsync(PluginSourceSettingsItem source)
    {
        if (isSaving || checkingSourceId is not null || !source.Enabled || !source.TrustConfirmed)
        {
            return;
        }

        checkingSourceId = source.Id;
        message = null;
        PluginUpdateCheckResult? result = null;
        string? failure = null;
        string? reloadError = null;
        try
        {
            result = await PluginSettingsService.CheckSourceForUpdatesAsync(source.Id);
        }
        catch (Exception ex)
        {
            failure = ex.Message;
        }
        finally
        {
            checkingSourceId = null;
            try
            {
                // Refresh only the sources list so the status column updates without
                // collapsing the whole panel into the loading state.
                await ReloadSourcesAsync();
            }
            catch (Exception ex)
            {
                reloadError = ex.Message;
            }
        }

        // The check outcome wins over a reload failure: the result message is set first and a
        // reload error is only shown when the check itself produced no message to keep.
        if (failure is not null)
        {
            messageClass = "alert alert-danger py-2";
            message = $"{Localizer["PluginCheckFailed"]} ({failure})";
        }
        else
        {
            switch (result!.Outcome)
            {
                case PluginUpdateCheckOutcome.Installed:
                    messageClass = "alert alert-success py-2";
                    message = Localizer["PluginCheckInstalled", result.ReleaseTag ?? string.Empty];
                    break;
                case PluginUpdateCheckOutcome.Failed:
                    messageClass = "alert alert-danger py-2";
                    message = MapCheckError(result.Error);
                    break;
                default:
                    messageClass = "alert alert-success py-2";
                    message = Localizer["PluginCheckNoUpdate"];
                    break;
            }
        }

        if (message is null && reloadError is not null)
        {
            messageClass = "alert alert-danger py-2";
            message = Localizer["PluginsLoadFailed", reloadError];
        }
    }

    private string CheckButtonTitle(PluginSourceSettingsItem source)
    {
        if (checkingSourceId is not null || isSaving)
        {
            return Localizer["PluginCheckBusyTooltip"];
        }

        if (!source.Enabled)
        {
            return Localizer["PluginCheckSourceDisabled"];
        }

        if (!source.TrustConfirmed)
        {
            return Localizer["PluginCheckSourceNotTrusted"];
        }

        return Localizer["CheckForUpdates"];
    }

    private string EditButtonTitle()
    {
        return checkingSourceId is not null || isSaving ? Localizer["PluginCheckBusyTooltip"] : Localizer["Edit"];
    }

    private string DeleteButtonTitle()
    {
        return checkingSourceId is not null || isSaving ? Localizer["PluginCheckBusyTooltip"] : Localizer["Delete"];
    }

    private string MapCheckError(string? error)
    {
        return error switch
        {
            PluginUpdateCheckErrors.SourceNotFound => Localizer["PluginCheckSourceNotFound"],
            PluginUpdateCheckErrors.SourceDisabled => Localizer["PluginCheckSourceDisabled"],
            PluginUpdateCheckErrors.SourceNotTrusted => Localizer["PluginCheckSourceNotTrusted"],
            PluginUpdateCheckErrors.PrivateSourceNoPat => Localizer["PluginCheckNoPat"],
            PluginUpdateCheckErrors.NoPublishedRelease => Localizer["PluginCheckNoRelease"],
            PluginUpdateCheckErrors.NoZipAsset => Localizer["PluginCheckNoZipAsset"],
            PluginUpdateCheckErrors.ValidationFailed => Localizer["PluginCheckValidationFailed"],
            PluginUpdateCheckErrors.RateLimited => Localizer["PluginCheckRateLimited"],
            PluginUpdateCheckErrors.WorkDirectoryUnavailable => Localizer["PluginCheckWorkDirectoryUnavailable"],
            not null => $"{Localizer["PluginCheckFailed"]} ({error})",
            _ => Localizer["PluginCheckFailed"]
        };
    }

    private async Task SaveSourceAsync()
    {
        isSaving = true;
        message = null;
        try
        {
            await PluginSettingsService.SaveSourceAsync(new PluginSourceSaveRequest(
                sourceForm.Id,
                sourceForm.RepositoryUrl,
                sourceForm.IsPrivate,
                sourceForm.Enabled,
                sourceForm.TrustConfirmed,
                sourceForm.PersonalAccessToken));
            ResetSourceForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = Localizer["SourceSaveFailed", ex.Message];
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SetSourceEnabledAsync(string sourceId, ChangeEventArgs args)
    {
        var enabled = args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        isSaving = true;
        message = null;
        try
        {
            await PluginSettingsService.SetSourceEnabledAsync(sourceId, enabled);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = Localizer["SourceSaveFailed", ex.Message];
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteSourceAsync(string sourceId)
    {
        isSaving = true;
        message = null;
        try
        {
            await PluginSettingsService.DeleteSourceAsync(sourceId);
            ResetSourceForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = Localizer["SourceDeleteFailed", ex.Message];
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditSource(PluginSourceSettingsItem source)
    {
        sourceForm = new SourceForm
        {
            Id = source.Id,
            RepositoryUrl = source.RepositoryUrl,
            IsPrivate = source.IsPrivate,
            Enabled = source.Enabled,
            TrustConfirmed = source.TrustConfirmed,
            PersonalAccessToken = null
        };
    }

    private void ResetSourceForm()
    {
        sourceForm = new SourceForm();
    }

    private async Task SetEnabledAsync(string pluginId, ChangeEventArgs args)
    {
        var enabled = args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        isSaving = true;
        message = null;
        try
        {
            await PluginSettingsService.SetEnabledAsync(pluginId, enabled);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = Localizer["PluginSaveFailed", ex.Message];
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RemovePluginEntryAsync(PluginSettingsItem plugin)
    {
        if (isSaving || plugin.Status != PluginStatus.Missing)
        {
            return;
        }

        isSaving = true;
        message = null;
        try
        {
            await PluginSettingsService.RemovePluginAsync(plugin.PluginId);
            await LoadAsync();

            // LoadAsync clears the message at its start, so the success message can only be
            // assigned after the reload. A reload failure sets PluginsLoadFailed itself —
            // that error must win over the success message and keep the danger styling.
            if (message is null)
            {
                messageClass = "alert alert-success py-2";
                message = Localizer["PluginRemoved"];
            }
            else
            {
                messageClass = "alert alert-danger py-2";
            }
        }
        catch (Exception ex)
        {
            messageClass = "alert alert-danger py-2";
            message = Localizer["PluginRemoveFailed", ex.Message];
        }
        finally
        {
            isSaving = false;
        }
    }

    private string RemoveButtonTitle(PluginSettingsItem plugin)
    {
        return isSaving ? Localizer["PluginCheckBusyTooltip"] : Localizer["RemovePluginFor", plugin.DisplayName];
    }

    private async Task MoveAsync(string pluginId, int direction)
    {
        isSaving = true;
        message = null;
        try
        {
            await PluginSettingsService.MoveAsync(pluginId, direction);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = Localizer["OrderSaveFailed", ex.Message];
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string StatusClass(string status) => status switch
    {
        PluginStatus.Loaded => "badge text-bg-success",
        PluginStatus.Missing => "badge text-bg-warning",
        PluginStatus.Incompatible => "badge text-bg-danger",
        PluginStatus.LoadFailed => "badge text-bg-danger",
        _ => "badge text-bg-secondary"
    };

    private sealed class SourceForm
    {
        public string? Id { get; set; }
        public string RepositoryUrl { get; set; } = string.Empty;
        public bool IsPrivate { get; set; }
        public bool Enabled { get; set; } = true;
        public bool TrustConfirmed { get; set; }
        public string? PersonalAccessToken { get; set; }
    }
}
