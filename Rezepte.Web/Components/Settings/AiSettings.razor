@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject ApiClient Client
@inject AuthenticationStateProvider AuthStateProvider

<div>
    <h6>Nutzung von KI</h6>

    @if (isLoading)
    {
        <div>Lade…</div>
    }
    else
    {
        @if (isAdmin)
        {
            <hr />
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="globalAi" checked="@globalAiEnabled" @onchange="OnGlobalToggle" disabled="@isSaving" />
                <label class="form-check-label" for="globalAi">KI global aktiv (Admin)</label>
            </div>

            <div class="ps-3 mt-2">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="globalGoogle" checked="@(globalAiEnabled && globalGoogleVisionEnabled)" @onchange="OnGlobalGoogleToggle" disabled="@(isSaving || !globalAiEnabled)" />
                    <label class="form-check-label" for="globalGoogle">Google Vision global aktiv (Admin)</label>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="globalGemini" checked="@(globalAiEnabled && globalGeminiEnabled)" @onchange="OnGlobalGeminiToggle" disabled="@(isSaving || !globalAiEnabled)" />
                    <label class="form-check-label" for="globalGemini">Gemini global aktiv (Admin)</label>
                </div>
            </div>
        }

        <div class="form-check form-switch mb-3 mt-3">
            <input class="form-check-input"
                   type="checkbox"
                   id="userAi"
                   checked="@userAiEnabled"
                   @onchange="OnUserToggle"
                   disabled="@(isSaving || !globalAiEnabled)" />
            <label class="form-check-label" for="userAi">KI für mein Konto aktivieren</label>
        </div>

        <div class="ps-3">
            <div class="d-flex align-items-start mb-2">
                <div class="form-check form-switch flex-grow-1">
                    <input class="form-check-input"
                           type="checkbox"
                           id="userGoogle"
                           checked="@(userAiEnabled && userGoogleVisionEnabled)"
                           @onchange="OnUserGoogleToggle"
                           disabled="@(isSaving || !globalAiEnabled || !globalGoogleVisionEnabled)" />
                    <label class="form-check-label" for="userGoogle">Google Vision für mein Konto aktivieren</label>
                </div>
                <button class="btn btn-link p-0 ms-2" title="Info" @onclick="ToggleGoogleInfo" aria-label="Info Google Vision">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" role="img" focusable="false">
                      <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.25"/>
                      <circle cx="8" cy="4.5" r="0.9" fill="currentColor"/>
                      <rect x="7.1" y="6.5" width="1.8" height="5" rx="0.3" fill="currentColor"/>
                    </svg>
                </button>
            </div>

            <div class="d-flex align-items-start mb-2">
                <div class="form-check form-switch flex-grow-1">
                    <input class="form-check-input"
                           type="checkbox"
                           id="userGemini"
                           checked="@(userAiEnabled && userGeminiEnabled)"
                           @onchange="OnUserGeminiToggle"
                           disabled="@(isSaving || !globalAiEnabled || !globalGeminiEnabled)" />
                    <label class="form-check-label" for="userGemini">Gemini für mein Konto aktivieren</label>
                </div>
                <button class="btn btn-link p-0 ms-2" title="Info" @onclick="ToggleGeminiInfo" aria-label="Info Gemini">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" role="img" focusable="false">
                      <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.25"/>
                      <circle cx="8" cy="4.5" r="0.9" fill="currentColor"/>
                      <rect x="7.1" y="6.5" width="1.8" height="5" rx="0.3" fill="currentColor"/>
                    </svg>
                </button>
            </div>

            <!-- New: require confirmation before using AI -->
            <div class="d-flex align-items-start mt-2">
                <div class="form-check form-switch flex-grow-1">
                    <input class="form-check-input"
                           type="checkbox"
                           id="requireAiConfirm"
                           checked="@requireAiConfirmation"
                           @onchange="OnUserRequireConfirm"
                           disabled="@(isSaving || !userAiEnabled)" />
                    <label class="form-check-label" for="requireAiConfirm">Bestätigung vor KI‑Nutzung anfordern</label>
                </div>
                <button class="btn btn-link p-0 ms-2" title="Info" @onclick="ToggleConfirmInfo" aria-label="Info Bestätigung">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" role="img" focusable="false">
                      <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.25"/>
                      <circle cx="8" cy="4.5" r="0.9" fill="currentColor"/>
                      <rect x="7.1" y="6.5" width="1.8" height="5" rx="0.3" fill="currentColor"/>
                    </svg>
                </button>
            </div>
        </div>

        @if (!globalAiEnabled && !isAdmin)
        {
            <div class="text-muted small mb-2">KI ist global deaktiviert — Ihre Einstellung ist gesperrt.</div>
        }
        @if (!globalGoogleVisionEnabled && !isAdmin)
        {
            <div class="text-muted small mb-2">Google Vision ist vom Administrator deaktiviert — Ihre Einstellung ist gesperrt.</div>
        }
        @if (!globalGeminiEnabled && !isAdmin)
        {
            <div class="text-muted small mb-2">Gemini ist vom Administrator deaktiviert — Ihre Einstellung ist gesperrt.</div>
        }               
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="mt-2 text-danger">@message</div>
    }
</div>

@if (showInfoGoogle || showInfoGemini || showInfoConfirm)
{
    <div class="ai-info-backdrop" @onclick="CloseOverlays"></div>

    <div class="ai-info-overlay" role="dialog" aria-modal="true">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="m-0">
                @if (showInfoGoogle) { <text>Google Vision</text> }
                else if (showInfoGemini) { <text>Gemini</text> }
                else { <text>Bestätigung vor KI‑Nutzung</text> }
            </h6>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CloseOverlays">Schließen</button>
        </div>
        <div>
            @if (showInfoGoogle)
            {
                <p>Google Vision wird für die Erkennung von Text in Bilddateien verwendet. Bei Fotoerkennung werden GoogleVision und zusätzlich Gemini zur Extraktion von Rezeptinformationen eingesetzt.</p>
            }
            else if (showInfoGemini)
            {
                <p>Gemini wird für das Auslesen von Rezeptinformationen aus Texten benötigt. Beim Auslesen von Webseiten wird nur Gemini benötigt; bei Fotoerkennung wird Gemini zusammen mit Google Vision verwendet.</p>
            }
            else if (showInfoConfirm)
            {
                <p>Wenn diese Option aktiviert ist, erscheint vor jeder Aktion, die KI‑Dienste nutzt, eine kurze Bestätigungsabfrage. Das verhindert unbeabsichtigte KI‑Anfragen.</p>
            }
        </div>
    </div>
}

<style>
    .ai-info-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        z-index: 1050;
    }
    .ai-info-overlay {
        position: fixed;
        left: 50%;
        top: 25%;
        transform: translateX(-50%);
        max-width: 640px;
        width: calc(100% - 32px);
        background: white;
        padding: 1rem;
        border-radius: 6px;
        box-shadow: 0 6px 24px rgba(0,0,0,0.2);
        z-index: 1060;
    }
    @@media (max-width: 576px) {
        .ai-info-overlay { top: 10%; }
    }
</style>

@code {
    private bool isLoading = true;
    private bool isSaving;
    private bool userAiEnabled;
    private bool globalAiEnabled;
    private bool serviceAccountAvailable;
    private bool geminiApiKeyAvailable;
    private bool isAdmin;
    private string? message;

    // New per-service flags
    private bool userGoogleVisionEnabled;
    private bool userGeminiEnabled;
    private bool globalGoogleVisionEnabled;
    private bool globalGeminiEnabled;

    // New: require confirmation flag
    private bool requireAiConfirmation;

    // Info overlays
    private bool showInfoGoogle;
    private bool showInfoGemini;
    private bool showInfoConfirm;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        message = null;
        try
        {
            var resp = await Client.Http.GetAsync("api/settings/me");
            if (!resp.IsSuccessStatusCode)
            {
                message = "Einstellungen konnten nicht geladen werden.";
                return;
            }

            var json = await resp.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(json))
            {
                using var doc = JsonDocument.Parse(json);
                var root = doc.RootElement;

                // handle different casings and types (bool or "True"/"true")
                if (TryGetBoolean(root, "AiEnabled", "aiEnabled", out var ai))
                    userAiEnabled = ai;
                if (TryGetBoolean(root, "GlobalAiEnabled", "globalAiEnabled", out var ga))
                    globalAiEnabled = ga;
                if (TryGetBoolean(root, "GoogleServiceAccountFileAvailable", "googleServiceAccountFileAvailable", out var sa))
                    serviceAccountAvailable = sa;
                if (TryGetBoolean(root, "GeminiApiKeyAvailable", "geminiApiKeyAvailable", out var gk))
                    geminiApiKeyAvailable = gk;

                // new properties (user-level)
                if (TryGetBoolean(root, "UserGoogleVisionEnabled", "userGoogleVisionEnabled", out var ugv))
                    userGoogleVisionEnabled = ugv;
                if (TryGetBoolean(root, "UserGeminiEnabled", "userGeminiEnabled", out var ugm))
                    userGeminiEnabled = ugm;
                if (TryGetBoolean(root, "RequireAiConfirmation", "requireAiConfirmation", out var rq))
                    requireAiConfirmation = rq;

                // new properties (global) - API may expose these on same endpoint or different; try common names
                if (TryGetBoolean(root, "GlobalGoogleVisionEnabled", "globalGoogleVisionEnabled", out var ggv))
                    globalGoogleVisionEnabled = ggv;
                if (TryGetBoolean(root, "GlobalGeminiEnabled", "globalGeminiEnabled", out var ggm))
                    globalGeminiEnabled = ggm;
            }

            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            isAdmin = auth.User.IsInRole("Admin");
        }
        catch
        {
            message = "Fehler beim Laden.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static bool TryGetBoolean(JsonElement root, string prop1, string prop2, out bool value)
    {
        value = false;
        if (root.ValueKind != JsonValueKind.Object) return false;

        if (root.TryGetProperty(prop1, out var el) || root.TryGetProperty(prop2, out el))
        {
            if (el.ValueKind == JsonValueKind.True) { value = true; return true; }
            if (el.ValueKind == JsonValueKind.False) { value = false; return true; }
            if (el.ValueKind == JsonValueKind.String)
            {
                var s = el.GetString();
                if (!string.IsNullOrEmpty(s) && bool.TryParse(s, out var b)) { value = b; return true; }
            }
        }
        return false;
    }

    private static bool ParseChangeEventBool(ChangeEventArgs e, bool fallback)
    {
        if (e.Value is bool b) return b;
        if (e.Value is string s && bool.TryParse(s, out var pb)) return pb;
        return fallback;
    }

    private async Task OnUserToggle(ChangeEventArgs e)
    {
        if (!globalAiEnabled)
        {
            message = "Die Benutzer‑Einstellung ist gesperrt, solange KI global deaktiviert ist.";
            return;
        }

        isSaving = true;
        message = null;
        try
        {
            userAiEnabled = ParseChangeEventBool(e, userAiEnabled);
            var ok = await Client.PutAsJsonAsync("api/settings/me/ai", userAiEnabled);
            if (!ok.IsSuccessStatusCode) message = "Speichern fehlgeschlagen.";

            await Client.Http.PostAsJsonAsync("api/logs", new { Action = "ToggleUserAi", Success = ok.IsSuccessStatusCode, Time = DateTime.UtcNow });
        }
        catch (Exception ex)
        {
            message = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task OnUserGoogleToggle(ChangeEventArgs e)
    {
        if (!globalAiEnabled || !globalGoogleVisionEnabled)
        {
            message = "Diese Einstellung ist gesperrt, solange global KI oder Google Vision deaktiviert ist.";
            return;
        }

        isSaving = true;
        message = null;
        try
        {
            userGoogleVisionEnabled = ParseChangeEventBool(e, userGoogleVisionEnabled);
            var ok = await Client.PutAsJsonAsync("api/settings/me/ai/googlevision", userGoogleVisionEnabled);
            if (!ok.IsSuccessStatusCode) message = "Speichern fehlgeschlagen.";

            await Client.Http.PostAsJsonAsync("api/logs", new { Action = "ToggleUserGoogleVision", Success = ok.IsSuccessStatusCode, Time = DateTime.UtcNow });
        }
        catch (Exception ex)
        {
            message = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task OnUserGeminiToggle(ChangeEventArgs e)
    {
        if (!globalAiEnabled || !globalGeminiEnabled)
        {
            message = "Diese Einstellung ist gesperrt, solange global KI oder Gemini deaktiviert ist.";
            return;
        }

        isSaving = true;
        message = null;
        try
        {
            userGeminiEnabled = ParseChangeEventBool(e, userGeminiEnabled);
            var ok = await Client.PutAsJsonAsync("api/settings/me/ai/gemini", userGeminiEnabled);
            if (!ok.IsSuccessStatusCode) message = "Speichern fehlgeschlagen.";

            await Client.Http.PostAsJsonAsync("api/logs", new { Action = "ToggleUserGemini", Success = ok.IsSuccessStatusCode, Time = DateTime.UtcNow });
        }
        catch (Exception ex)
        {
            message = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task OnUserRequireConfirm(ChangeEventArgs e)
    {
        // Only meaningful if user-level AI is enabled
        if (!userAiEnabled)
        {
            message = "Aktivieren Sie zuerst KI für Ihr Konto, um diese Option zu verwenden.";
            return;
        }

        isSaving = true;
        message = null;
        try
        {
            requireAiConfirmation = ParseChangeEventBool(e, requireAiConfirmation);
            var ok = await Client.PutAsJsonAsync("api/settings/me/ai/confirm", requireAiConfirmation);
            if (!ok.IsSuccessStatusCode) message = "Speichern fehlgeschlagen.";

            await Client.Http.PostAsJsonAsync("api/logs", new { Action = "ToggleRequireAiConfirmation", Success = ok.IsSuccessStatusCode, Time = DateTime.UtcNow });
        }
        catch (Exception ex)
        {
            message = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task OnGlobalToggle(ChangeEventArgs e)
    {
        isSaving = true;
        message = null;
        try
        {
            globalAiEnabled = ParseChangeEventBool(e, globalAiEnabled);
            var ok = await Client.PutAsJsonAsync("api/settings/global/ai", globalAiEnabled);
            if (!ok.IsSuccessStatusCode)
            {
                message = "Speichern fehlgeschlagen.";
            }
            else
            {
                if (!globalAiEnabled)
                {
                    await LoadAsync();
                }
            }

            await Client.Http.PostAsJsonAsync("api/logs", new { Action = "ToggleGlobalAi", Success = ok.IsSuccessStatusCode, Time = DateTime.UtcNow });
        }
        catch (Exception ex)
        {
            message = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task OnGlobalGoogleToggle(ChangeEventArgs e)
    {
        isSaving = true;
        message = null;
        try
        {
            globalGoogleVisionEnabled = ParseChangeEventBool(e, globalGoogleVisionEnabled);
            var ok = await Client.PutAsJsonAsync("api/settings/global/ai/googlevision", globalGoogleVisionEnabled);
            if (!ok.IsSuccessStatusCode)
            {
                message = "Speichern fehlgeschlagen.";
            }
            else
            {
                if (!globalGoogleVisionEnabled)
                    await LoadAsync();
            }

            await Client.Http.PostAsJsonAsync("api/logs", new { Action = "ToggleGlobalGoogleVision", Success = ok.IsSuccessStatusCode, Time = DateTime.UtcNow });
        }
        catch (Exception ex)
        {
            message = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task OnGlobalGeminiToggle(ChangeEventArgs e)
    {
        isSaving = true;
        message = null;
        try
        {
            globalGeminiEnabled = ParseChangeEventBool(e, globalGeminiEnabled);
            var ok = await Client.PutAsJsonAsync("api/settings/global/ai/gemini", globalGeminiEnabled);
            if (!ok.IsSuccessStatusCode)
            {
                message = "Speichern fehlgeschlagen.";
            }
            else
            {
                if (!globalGeminiEnabled)
                    await LoadAsync();
            }

            await Client.Http.PostAsJsonAsync("api/logs", new { Action = "ToggleGlobalGemini", Success = ok.IsSuccessStatusCode, Time = DateTime.UtcNow });
        }
        catch (Exception ex)
        {
            message = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    // Info overlay helpers
    private void ToggleGoogleInfo()
    {
        showInfoGoogle = !showInfoGoogle;
        showInfoGemini = false;
        showInfoConfirm = false;
    }

    private void ToggleGeminiInfo()
    {
        showInfoGemini = !showInfoGemini;
        showInfoGoogle = false;
        showInfoConfirm = false;
    }

    private void ToggleConfirmInfo()
    {
        showInfoConfirm = !showInfoConfirm;
        showInfoGoogle = false;
        showInfoGemini = false;
    }

    private void CloseOverlays()
    {
        showInfoGoogle = false;
        showInfoGemini = false;
        showInfoConfirm = false;
    }
}