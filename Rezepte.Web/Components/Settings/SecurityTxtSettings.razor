@inject ApiClient Client
@inject ILogger<Rezepte.Web.Components.Settings.SecurityTxtSettings> Logger

@if (isLoading)
{
    <div>Lade...</div>
}
else if (!string.IsNullOrWhiteSpace(loadErrorMessage))
{
    <div class="alert alert-danger py-2">@loadErrorMessage</div>
}
else
{
    <section>
        <h3 class="h6">security.txt (RFC 9116)</h3>
        <p class="text-muted small mb-3">
            Hinterlegen Sie hier die öffentlichen Kontakt- und Policy-Angaben für Sicherheitsmeldungen.
            Canonical-URLs können optional manuell angegeben werden. Wenn das Feld leer bleibt, wird die URL automatisch aus der Anfrage bestimmt.
        </p>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2">@successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(saveErrorMessage))
        {
            <div class="alert alert-danger py-2">@saveErrorMessage</div>
        }

        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="securitytxt-enabled" @bind="Enabled" @bind:event="onchange" disabled="@isSaving" />
            <label class="form-check-label" for="securitytxt-enabled">security.txt aktivieren</label>
        </div>

        <div class="mb-2">
            <label class="form-label small" for="securitytxt-contact">Contact (ein URI oder E-Mail pro Zeile, Pflichtfeld)</label>
            <textarea id="securitytxt-contact" class="form-control form-control-sm" rows="3" @bind="Contact" disabled="@isSaving"></textarea>
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-expires">Expires (Pflichtfeld)</label>
            <input id="securitytxt-expires" class="form-control form-control-sm" type="datetime-local" value="@ExpiresLocal" @onchange="OnExpiresChanged" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-encryption">Encryption</label>
            <input id="securitytxt-encryption" class="form-control form-control-sm" type="text" @bind="Encryption" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-acknowledgments">Acknowledgments (ein URI pro Zeile)</label>
            <textarea id="securitytxt-acknowledgments" class="form-control form-control-sm" rows="3" @bind="Acknowledgments" disabled="@isSaving"></textarea>
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-preferred-languages">Preferred-Languages</label>
            <input id="securitytxt-preferred-languages" class="form-control form-control-sm" type="text" @bind="PreferredLanguages" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-canonical">Canonical (optional; wenn leer, wird die URL automatisch bestimmt)</label>
            <input id="securitytxt-canonical" class="form-control form-control-sm" type="text" @bind="Canonical" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-policy">Policy</label>
            <input id="securitytxt-policy" class="form-control form-control-sm" type="text" @bind="Policy" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-hiring">Hiring</label>
            <input id="securitytxt-hiring" class="form-control form-control-sm" type="text" @bind="Hiring" disabled="@isSaving" />
        </div>

        <button class="btn btn-primary btn-sm mt-2" @onclick="SaveAsync" disabled="@isSaving">Speichern</button>
    </section>
}

@code {
    private Rezepte.Web.Dtos.SecurityTxtSettings form = EmptySettings;
    private bool isLoading = true;
    private bool isSaving;
    private string? loadErrorMessage;
    private string? saveErrorMessage;
    private string? successMessage;

    private static Rezepte.Web.Dtos.SecurityTxtSettings EmptySettings => new(
        Enabled: false,
        Contact: null,
        Expires: null,
        Encryption: null,
        Acknowledgments: null,
        PreferredLanguages: null,
        Canonical: null,
        Policy: null,
        Hiring: null);

    private bool Enabled
    {
        get => form.Enabled;
        set => form = form with { Enabled = value };
    }

    private string? Contact
    {
        get => form.Contact;
        set => form = form with { Contact = value };
    }

    private string ExpiresLocal => form.Expires.HasValue
        ? form.Expires.Value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")
        : string.Empty;

    private string? Encryption
    {
        get => form.Encryption;
        set => form = form with { Encryption = value };
    }

    private string? Acknowledgments
    {
        get => form.Acknowledgments;
        set => form = form with { Acknowledgments = value };
    }

    private string? PreferredLanguages
    {
        get => form.PreferredLanguages;
        set => form = form with { PreferredLanguages = value };
    }

    private string? Canonical
    {
        get => form.Canonical;
        set => form = form with { Canonical = value };
    }

    private string? Policy
    {
        get => form.Policy;
        set => form = form with { Policy = value };
    }

    private string? Hiring
    {
        get => form.Hiring;
        set => form = form with { Hiring = value };
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadErrorMessage = null;
        try
        {
            var settings = await Client.GetAsync<Rezepte.Web.Dtos.SecurityTxtSettings>("api/settings/global/securitytxt");
            if (settings != null)
            {
                form = settings;
            }
        }
        catch (HttpRequestException)
        {
            loadErrorMessage = "Einstellungen konnten nicht geladen werden.";
        }
        catch (TaskCanceledException)
        {
            loadErrorMessage = "Laden dauert zu lange. Bitte erneut versuchen.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unerwarteter Fehler beim Laden der security.txt-Einstellungen.");
            loadErrorMessage = "Ein unerwarteter Fehler ist aufgetreten.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        successMessage = null;
        saveErrorMessage = null;
        try
        {
            var response = await Client.PutAsJsonAsync("api/settings/global/securitytxt", form);
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Einstellungen gespeichert.";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                saveErrorMessage = $"Fehler: {body}";
            }
        }
        catch (HttpRequestException)
        {
            saveErrorMessage = "Einstellungen konnten nicht gespeichert werden.";
        }
        catch (TaskCanceledException)
        {
            saveErrorMessage = "Speichern dauert zu lange. Bitte erneut versuchen.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unerwarteter Fehler beim Speichern der security.txt-Einstellungen.");
            saveErrorMessage = "Ein unerwarteter Fehler ist aufgetreten.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OnExpiresChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParse(args.Value?.ToString(), out var dt))
            form = form with { Expires = new DateTimeOffset(DateTime.SpecifyKind(dt, DateTimeKind.Local)) };
        else
            form = form with { Expires = null };
    }
}
