@using System.Net.Http.Json
@inject ApiClient Client

@if (isLoading)
{
    <div>Lade...</div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger py-2">@errorMessage</div>
}
else
{
    <section>
        <h3 class="h6">security.txt (RFC 9116)</h3>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2">@successMessage</div>
        }

        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="securitytxt-enabled" checked="@form.Enabled" @onchange="OnEnabledChanged" disabled="@isSaving" />
            <label class="form-check-label" for="securitytxt-enabled">security.txt aktivieren</label>
        </div>

        <div class="mb-2">
            <label class="form-label small" for="securitytxt-contact">Contact (ein URI oder E-Mail pro Zeile, Pflichtfeld)</label>
            <textarea id="securitytxt-contact" class="form-control form-control-sm" rows="3" @bind="form.Contact" disabled="@isSaving"></textarea>
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-expires">Expires (Pflichtfeld)</label>
            <input id="securitytxt-expires" class="form-control form-control-sm" type="datetime-local" value="@ExpiresLocal" @onchange="OnExpiresChanged" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-encryption">Encryption</label>
            <input id="securitytxt-encryption" class="form-control form-control-sm" type="text" @bind="form.Encryption" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-acknowledgments">Acknowledgments (ein URI pro Zeile)</label>
            <textarea id="securitytxt-acknowledgments" class="form-control form-control-sm" rows="3" @bind="form.Acknowledgments" disabled="@isSaving"></textarea>
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-preferred-languages">Preferred-Languages</label>
            <input id="securitytxt-preferred-languages" class="form-control form-control-sm" type="text" @bind="form.PreferredLanguages" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-canonical">Canonical</label>
            <input id="securitytxt-canonical" class="form-control form-control-sm" type="text" @bind="form.Canonical" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-policy">Policy</label>
            <input id="securitytxt-policy" class="form-control form-control-sm" type="text" @bind="form.Policy" disabled="@isSaving" />
        </div>
        <div class="mb-2">
            <label class="form-label small" for="securitytxt-hiring">Hiring</label>
            <input id="securitytxt-hiring" class="form-control form-control-sm" type="text" @bind="form.Hiring" disabled="@isSaving" />
        </div>

        <button class="btn btn-primary btn-sm mt-2" @onclick="SaveAsync" disabled="@isSaving">Speichern</button>
    </section>
}

@code {
    private SecurityTxtForm form = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    private string ExpiresLocal => form.Expires.HasValue
        ? form.Expires.Value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")
        : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var settings = await Client.GetAsync<Rezepte.Web.Dtos.SecurityTxtSettings>("api/settings/global/securitytxt");
            if (settings != null)
            {
                form = new SecurityTxtForm
                {
                    Enabled = settings.Enabled,
                    Contact = settings.Contact,
                    Expires = settings.Expires,
                    Encryption = settings.Encryption,
                    Acknowledgments = settings.Acknowledgments,
                    PreferredLanguages = settings.PreferredLanguages,
                    Canonical = settings.Canonical,
                    Policy = settings.Policy,
                    Hiring = settings.Hiring
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Einstellungen konnten nicht geladen werden: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        successMessage = null;
        errorMessage = null;
        try
        {
            var settings = new Rezepte.Web.Dtos.SecurityTxtSettings(
                Enabled: form.Enabled,
                Contact: form.Contact,
                Expires: form.Expires,
                Encryption: form.Encryption,
                Acknowledgments: form.Acknowledgments,
                PreferredLanguages: form.PreferredLanguages,
                Canonical: form.Canonical,
                Policy: form.Policy,
                Hiring: form.Hiring);

            var response = await Client.PutAsJsonAsync("api/settings/global/securitytxt", settings);
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Einstellungen gespeichert.";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Fehler: {body}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Einstellungen konnten nicht gespeichert werden: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OnEnabledChanged(ChangeEventArgs args)
    {
        form.Enabled = args.Value is bool b ? b : bool.TryParse(args.Value?.ToString(), out var v) && v;
    }

    private void OnExpiresChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParse(args.Value?.ToString(), out var dt))
            form.Expires = new DateTimeOffset(DateTime.SpecifyKind(dt, DateTimeKind.Local));
        else
            form.Expires = null;
    }

    private sealed class SecurityTxtForm
    {
        public bool Enabled { get; set; }
        public string? Contact { get; set; }
        public DateTimeOffset? Expires { get; set; }
        public string? Encryption { get; set; }
        public string? Acknowledgments { get; set; }
        public string? PreferredLanguages { get; set; }
        public string? Canonical { get; set; }
        public string? Policy { get; set; }
        public string? Hiring { get; set; }
    }
}
