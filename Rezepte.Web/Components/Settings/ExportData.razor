@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@inject ApiClient Api
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<div class="p-3">
    <h5>Datenexport</h5>
    <p class="text-muted">Exportiere deine Rezepte. Der Export wird im Hintergrund vorbereitet.</p>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="exportImages" @bind="includeImages" />
        <label class="form-check-label" for="exportImages">Bilder einbeziehen</label>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="exportPDFs" @bind="includePDFs" />
        <label class="form-check-label" for="exportPDFs">PDF pro Rezept</label>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="ExportOwnAsync" disabled="@isBusy">
            <i class="bi bi-download me-1"></i> Eigene Daten exportieren
        </button>
    </div>

    @if (isBusy)
    {
        <div class="progress mt-3" role="progressbar" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: @progress%">@progress%</div>
        </div>
        <div class="mt-2 text-muted">Export läuft...</div>
    }
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="mt-2 text-muted">@message</div>
    }
</div>

@code {
    private bool includeImages = false;
    private bool includePDFs = false;
    private bool isBusy;
    private int progress;
    private string? message;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
        isAdmin = auth.User?.IsInRole("Admin") ?? false;
    }

    private async Task ExportOwnAsync()
    {
        await ExportAsync("user").ConfigureAwait(false);
    }

    private async Task ExportAsync(string mode)
    {
        isBusy = true;
        message = null;
        try
        {
            if (mode == "user")
            {
                var response = await Api.Http.PostAsJsonAsync("api/jobs/exports/me", new
                {
                    includeImages,
                    includePdf = includePDFs
                });

                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    message = "Nicht angemeldet oder keine Berechtigung (401). Bitte anmelden.";
                    return;
                }

                if (!response.IsSuccessStatusCode)
                {
                    message = $"Export fehlgeschlagen: {response.StatusCode}";
                    return;
                }

                var started = await response.Content.ReadFromJsonAsync<JobStartResponse>();
                if (started?.JobId is null)
                {
                    message = "Export konnte nicht gestartet werden.";
                    return;
                }

                message = "Export gestartet.";
                await PollAndDownloadAsync(started.JobId.Value);
            }
            else
            {
                message = "Nicht berechtigt.";
                return;
            }
        }
        catch (Exception ex)
        {
            message = $"Export fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task PollAndDownloadAsync(Guid jobId)
    {
        while (true)
        {
            var status = await Api.Http.GetFromJsonAsync<JobStatusResponse>($"api/jobs/{jobId}");
            if (status is null)
            {
                message = "Exportstatus konnte nicht gelesen werden.";
                return;
            }

            progress = Math.Clamp(status.Progress, 0, 100);
            StateHasChanged();

            if (status.Status == 2)
            {
                if (await DownloadAsync(status.DownloadUrl ?? $"api/jobs/{jobId}/download"))
                {
                    message = "Download gestartet.";
                }
                return;
            }

            if (status.Status == 3 || status.Status == 4)
            {
                message = string.IsNullOrWhiteSpace(status.Error)
                    ? "Export fehlgeschlagen."
                    : $"Export fehlgeschlagen: {status.Error}";
                return;
            }

            await Task.Delay(TimeSpan.FromSeconds(1));
        }
    }

    private async Task<bool> DownloadAsync(string url)
    {
        var response = await Api.Http.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);
        if (!response.IsSuccessStatusCode)
        {
            message = $"Download fehlgeschlagen: {response.StatusCode}";
            return false;
        }

        var fileName = GetFileNameFromResponse(response) ?? $"recipes-{DateTime.UtcNow:yyyyMMddHHmm}.zip";
        var stream = await response.Content.ReadAsStreamAsync();

        using var streamRef = new DotNetStreamReference(stream: stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        return true;
    }

    private static string? GetFileNameFromResponse(HttpResponseMessage response)
    {
        if (response.Content?.Headers?.ContentDisposition?.FileNameStar is string fnStar && !string.IsNullOrWhiteSpace(fnStar))
            return fnStar.Trim('"');

        if (response.Content?.Headers?.ContentDisposition?.FileName is string fn && !string.IsNullOrWhiteSpace(fn))
            return fn.Trim('"');

        if (response.Content?.Headers?.Contains("Content-Disposition") ?? false)
        {
            var cd = response.Content.Headers.GetValues("Content-Disposition").FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(cd))
            {
                var idx = cd.IndexOf("filename=");
                if (idx >= 0)
                {
                    var filename = cd.Substring(idx + "filename=".Length).Trim().Trim('"');
                    if (!string.IsNullOrWhiteSpace(filename)) return filename;
                }
            }
        }
        return null;
    }

    private sealed class JobStartResponse
    {
        public Guid? JobId { get; set; }
    }

    private sealed class JobStatusResponse
    {
        public int Status { get; set; }
        public int Progress { get; set; }
        public string? Error { get; set; }
        public string? DownloadUrl { get; set; }
    }
}
