@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject ApiClient Api
@inject IJSRuntime JS

<div class="p-3">
    <h5>Sicherung (Admin)</h5>
    <p class="text-muted">Gesamtexport und Wiederherstellung der Anwendung (Admin).</p>

    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-outline-danger" @onclick="ExportAllAsync" disabled="@isBusy">
            <i class="bi bi-box-seam me-1"></i> Gesamtexport (Admin)
        </button>
    </div>

    <div class="mb-3">
        <label class="form-label">Wiederherstellen (ZIP-Datei)</label>
        <InputFile id="restoreFile" OnChange="OnFileSelected" />
        @if (selectedFileName != null)
        {
            <div class="mt-2">
                <small class="text-muted">AusgewÃ¤hlt: @selectedFileName</small>
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="RestoreAsync" disabled="@(isBusy || (selectedFile == null))">
            <i class="bi bi-arrow-clockwise me-1"></i> Wiederherstellen
        </button>
    </div>

    @if (isBusy)
    {
        <div class="progress mt-3" role="progressbar" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: @progress%">@progress%</div>
        </div>
        <div class="mt-2 text-muted">Vorgang lÃ¤uft...</div>
    }
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="mt-2 text-muted">@message</div>
    }
</div>

@code {
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private bool isBusy;
    private int progress;
    private string? message;

    private async Task ExportAllAsync()
    {
        isBusy = true;
        message = null;
        try
        {
            var response = await Api.Http.PostAsJsonAsync("api/jobs/exports/all", new
            {
                includeImages = true,
                includePdf = false
            });

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Nicht angemeldet oder keine Berechtigung (401).";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                message = $"Export fehlgeschlagen: {response.StatusCode}";
                return;
            }

            var started = await response.Content.ReadFromJsonAsync<JobStartResponse>();
            if (started?.JobId is null)
            {
                message = "Export konnte nicht gestartet werden.";
                return;
            }

            message = "Export gestartet.";
            await PollAndDownloadAsync(started.JobId.Value);
        }
        catch (Exception ex)
        {
            message = $"Export fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task PollAndDownloadAsync(Guid jobId)
    {
        while (true)
        {
            var status = await Api.Http.GetFromJsonAsync<JobStatusResponse>($"api/jobs/{jobId}");
            if (status is null)
            {
                message = "Exportstatus konnte nicht gelesen werden.";
                return;
            }

            progress = Math.Clamp(status.Progress, 0, 100);
            StateHasChanged();

            if (status.Status == 2)
            {
                if (await DownloadAsync(status.DownloadUrl ?? $"api/jobs/{jobId}/download"))
                {
                    message = "Download gestartet.";
                }
                return;
            }

            if (status.Status == 3 || status.Status == 4)
            {
                message = string.IsNullOrWhiteSpace(status.Error)
                    ? "Export fehlgeschlagen."
                    : $"Export fehlgeschlagen: {status.Error}";
                return;
            }

            await Task.Delay(TimeSpan.FromSeconds(1));
        }
    }

    private async Task<bool> DownloadAsync(string url)
    {
        var response = await Api.Http.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);
        if (!response.IsSuccessStatusCode)
        {
            message = $"Download fehlgeschlagen: {response.StatusCode}";
            return false;
        }

        var fileName = GetFileNameFromResponse(response) ?? $"export-all-{DateTime.UtcNow:yyyyMMddHHmm}.zip";
        var stream = await response.Content.ReadAsStreamAsync();
        using var streamRef = new DotNetStreamReference(stream: stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        return true;
    }

    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = selectedFile?.Name;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RestoreAsync()
    {
        if (selectedFile == null)
        {
            message = "Keine Datei ausgewÃ¤hlt.";
            return;
        }

        var okConfirm = await JS.InvokeAsync<bool>("confirm", "Wirklich wiederherstellen? Bestehende Daten werden Ã¼berschrieben.");
        if (!okConfirm) return;

        isBusy = true;
        message = null;
        try
        {
            // Use absolute (root-based) API path so fetch resolves correctly from any route
            var uploadUrl = "/api/admin/exports/restore";
            var success = await JS.InvokeAsync<bool>("backupRestore.uploadFileToApi", "restoreFile", uploadUrl);

            if (!success)
            {
                message = "Wiederherstellung fehlgeschlagen: Upload vom Browser an API nicht erfolgreich.";
                return;
            }

            message = "Wiederherstellung gestartet / abgeschlossen (Server-Antwort OK).";
        }
        catch (Exception ex)
        {
            message = $"Wiederherstellung fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string? GetFileNameFromResponse(HttpResponseMessage response)
    {
        if (response.Content?.Headers?.ContentDisposition?.FileNameStar is string fnStar && !string.IsNullOrWhiteSpace(fnStar))
            return fnStar.Trim('"');

        if (response.Content?.Headers?.ContentDisposition?.FileName is string fn && !string.IsNullOrWhiteSpace(fn))
            return fn.Trim('"');

        return null;
    }

    private sealed class JobStartResponse
    {
        public Guid? JobId { get; set; }
    }

    private sealed class JobStatusResponse
    {
        public int Status { get; set; }
        public int Progress { get; set; }
        public string? Error { get; set; }
        public string? DownloadUrl { get; set; }
    }
}
