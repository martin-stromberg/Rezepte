@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject ApiClient Api
@inject IJSRuntime JS

<div class="p-3">
    <h5>Sicherung (Admin)</h5>
    <p class="text-muted">Gesamtexport und Wiederherstellung der Anwendung (Admin).</p>

    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-outline-danger" @onclick="ExportAllAsync" disabled="@isBusy">
            <i class="bi bi-box-seam me-1"></i> Gesamtexport (Admin)
        </button>
    </div>

    <div class="mb-3">
        <label class="form-label">Wiederherstellen (ZIP-Datei)</label>
        <InputFile id="restoreFile" OnChange="OnFileSelected" />
        @if (selectedFileName != null)
        {
            <div class="mt-2">
                <small class="text-muted">Ausgewählt: @selectedFileName</small>
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="RestoreAsync" disabled="@(isBusy || (selectedFile == null))">
            <i class="bi bi-arrow-clockwise me-1"></i> Wiederherstellen
        </button>
    </div>

    @if (isBusy)
    {
        <div class="progress mt-3" role="progressbar" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: @progress%">@progress%</div>
        </div>
        <div class="mt-2 text-muted">Vorgang läuft...</div>
    }
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="mt-2 text-muted">@message</div>
    }

    <ExportFilesList @ref="exportFilesList" />

    <hr class="my-4" />

    <section>
        <h6>Bereinigung alter Sicherungen</h6>
        <p class="text-muted small">
            Exportdateien werden spätestens einen Tag nach ihrer Erstellung automatisch gelöscht.
            Die Bereinigung läuft täglich zur eingestellten Uhrzeit (Serverzeit). Wurde sie verpasst, weil die
            Anwendung nicht lief, wird sie beim nächsten Start nachgeholt.
        </p>

        <div class="row g-2 align-items-end mb-2">
            <div class="col-auto">
                <label class="form-label small" for="cleanup-time">Uhrzeit der Bereinigung</label>
                <input id="cleanup-time" class="form-control form-control-sm" type="time" @bind="cleanupTime" disabled="@isCleanupBusy" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary btn-sm" @onclick="SaveCleanupSettingsAsync" disabled="@isCleanupBusy">Speichern</button>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RunCleanupNowAsync" disabled="@isCleanupBusy">Jetzt bereinigen</button>
            </div>
        </div>

        @if (cleanupLastRunAt is not null)
        {
            <div class="text-muted small">Letzte Bereinigung: @cleanupLastRunAt.Value.LocalDateTime.ToString("g")</div>
        }
        else if (cleanupLoaded)
        {
            <div class="text-muted small">Bisher wurde noch keine Bereinigung ausgeführt.</div>
        }

        @if (!string.IsNullOrEmpty(cleanupMessage))
        {
            <div class="mt-2 text-muted small">@cleanupMessage</div>
        }
    </section>
</div>

@code {
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private bool isBusy;
    private int progress;
    private string? message;
    private ExportFilesList? exportFilesList;
    private TimeOnly cleanupTime = new(3, 0);
    private DateTimeOffset? cleanupLastRunAt;
    private bool cleanupLoaded;
    private bool isCleanupBusy;
    private string? cleanupMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCleanupSettingsAsync();
    }

    private async Task LoadCleanupSettingsAsync()
    {
        try
        {
            var settings = await Api.Http.GetFromJsonAsync<CleanupSettingsResponse>("api/admin/exports/cleanup");
            if (settings is not null)
            {
                cleanupTime = ParseCleanupTime(settings.CleanupTime) ?? cleanupTime;
                cleanupLastRunAt = settings.LastRunAt;
            }
            cleanupLoaded = true;
        }
        catch (Exception ex)
        {
            cleanupMessage = $"Bereinigungseinstellungen konnten nicht geladen werden: {ex.Message}";
        }
    }

    private async Task SaveCleanupSettingsAsync()
    {
        isCleanupBusy = true;
        cleanupMessage = null;
        try
        {
            var response = await Api.Http.PutAsJsonAsync("api/admin/exports/cleanup", new { cleanupTime = cleanupTime.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture) });
            if (!response.IsSuccessStatusCode)
            {
                cleanupMessage = $"Speichern fehlgeschlagen: {response.StatusCode}";
                return;
            }

            var settings = await response.Content.ReadFromJsonAsync<CleanupSettingsResponse>();
            if (settings is not null)
            {
                cleanupTime = ParseCleanupTime(settings.CleanupTime) ?? cleanupTime;
                cleanupLastRunAt = settings.LastRunAt;
            }
            cleanupMessage = "Uhrzeit gespeichert.";
        }
        catch (Exception ex)
        {
            cleanupMessage = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            isCleanupBusy = false;
        }
    }

    private async Task RunCleanupNowAsync()
    {
        isCleanupBusy = true;
        cleanupMessage = null;
        try
        {
            var response = await Api.Http.PostAsync("api/admin/exports/cleanup/run", null);
            if (!response.IsSuccessStatusCode)
            {
                cleanupMessage = $"Bereinigung fehlgeschlagen: {response.StatusCode}";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<CleanupRunResponse>();
            if (result is not null)
            {
                cleanupLastRunAt = result.RunAt;
                cleanupMessage = $"Bereinigung abgeschlossen: {result.DeletedFiles} Datei(en) gelöscht.";
            }

            if (exportFilesList is not null)
            {
                await exportFilesList.RefreshFilesAsync();
            }
        }
        catch (Exception ex)
        {
            cleanupMessage = $"Bereinigung fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            isCleanupBusy = false;
        }
    }

    private async Task ExportAllAsync()
    {
        isBusy = true;
        message = null;
        try
        {
            var response = await Api.Http.PostAsJsonAsync("api/jobs/exports/all", new
            {
                includeImages = true,
                includePdf = false
            });

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Nicht angemeldet oder keine Berechtigung (401).";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                message = $"Export fehlgeschlagen: {response.StatusCode}";
                return;
            }

            var started = await response.Content.ReadFromJsonAsync<JobStartResponse>();
            if (started?.JobId is null)
            {
                message = "Export konnte nicht gestartet werden.";
                return;
            }

            message = "Export gestartet.";
            await PollAsync(started.JobId.Value);
        }
        catch (Exception ex)
        {
            message = $"Export fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task PollAsync(Guid jobId)
    {
        while (true)
        {
            var status = await Api.Http.GetFromJsonAsync<JobStatusResponse>($"api/jobs/{jobId}");
            if (status is null)
            {
                await InvokeAsync(() =>
                {
                    message = "Exportstatus konnte nicht gelesen werden.";
                    StateHasChanged();
                });
                return;
            }

            await InvokeAsync(() =>
            {
                progress = Math.Clamp(status.Progress, 0, 100);
                StateHasChanged();
            });

            if (status.Status == 2)
            {
                await InvokeAsync(() =>
                {
                    message = "Export abgeschlossen. Die Datei ist in der Tabelle unten verfügbar.";
                    StateHasChanged();
                });
                if (exportFilesList is not null)
                {
                    await exportFilesList.RefreshFilesAsync().ConfigureAwait(false);
                }
                return;
            }

            if (status.Status == 3 || status.Status == 4)
            {
                await InvokeAsync(() =>
                {
                    message = string.IsNullOrWhiteSpace(status.Error)
                        ? "Export fehlgeschlagen."
                        : $"Export fehlgeschlagen: {status.Error}";
                    StateHasChanged();
                });
                return;
            }

            await Task.Delay(TimeSpan.FromSeconds(1));
        }
    }

    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = selectedFile?.Name;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RestoreAsync()
    {
        if (selectedFile == null)
        {
            message = "Keine Datei ausgewählt.";
            return;
        }

        var okConfirm = await JS.InvokeAsync<bool>("confirm", "Wirklich wiederherstellen? Bestehende Daten werden überschrieben.");
        if (!okConfirm) return;

        isBusy = true;
        message = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var fileStream = selectedFile.OpenReadStream(1_500_000_000L);
            content.Add(new StreamContent(fileStream), "file", selectedFile.Name);

            var response = await Api.Http.PostAsync("api/admin/exports/restore", content);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Wiederherstellung fehlgeschlagen: {response.StatusCode} {error}";
                return;
            }

            message = "Wiederherstellung gestartet / abgeschlossen (Server-Antwort OK).";
        }
        catch (Exception ex)
        {
            message = $"Wiederherstellung fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class JobStartResponse
    {
        public Guid? JobId { get; set; }
    }

    private static TimeOnly? ParseCleanupTime(string? value)
        => TimeOnly.TryParseExact(value, "HH:mm", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed)
            ? parsed
            : null;

    private sealed class CleanupSettingsResponse
    {
        public string? CleanupTime { get; set; }
        public DateTimeOffset? LastRunAt { get; set; }
    }

    private sealed class CleanupRunResponse
    {
        public int DeletedFiles { get; set; }
        public int DeletedRecords { get; set; }
        public DateTimeOffset RunAt { get; set; }
    }

    private sealed class JobStatusResponse
    {
        public int Status { get; set; }
        public int Progress { get; set; }
        public string? Error { get; set; }
        public string? DownloadUrl { get; set; }
    }
}
