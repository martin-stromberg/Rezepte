{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "rezepte",
    "Audience": "rezepte.api",
    "LifetimeMinutes": 43200
  },
  "Images": {
    "MaxSizeBytes": 5242880,
    "CacheMaxAgeSeconds": 3600,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "image/gif" ]
  },
  "PluginUpdates": {
    "GitHubApiBaseUrl": "https://api.github.com",
    "TimeoutSeconds": 30,
    "UserAgent": "Rezepte.PluginUpdater"
  },
  "UpdateBackups": {
    "Directory": "update-backups",
    "RetentionCount": 5,
    "IncludeImages": true,
    "IncludePdf": false,
    "SystemInitiatorUserId": "system-update-backup"
  },
  "ApplicationUpdates": {
    "Enabled": false,
    "EnableAutomaticDownload": true,
    "EnableAutomaticInstallation": false,
    "DownloadPath": "updates",
    "HostedServicesEnabled": true,
    "StopHostAfterScriptStart": false,
    "HealthTimeoutSeconds": 120,
    "UpdateUnitName": "RezepteWebAutoUpdate",
    "RepositoryOwner": "martin-stromberg",
    "RepositoryName": "Rezepte",
    "ManifestAssetName": "update.json"
  },
  "GoogleCredentials": {
    "ServiceAccountFilePath": "",
    "GeminiApiKey": ""
  },
  "LoadingBar": {
    "Enabled": true,
    "Height": "3px",
    "AnimationDuration": "2s",
    "HideDelay": "300ms",
    "MaxVisibleDuration": "15s",
    "Colors": [ "#FF6B6B", "#4ECDC4", "#45B7D1", "#96CEB4", "#FFEAA7", "#DDA0DD" ]
  }
}
