<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Rezepte.Models;assembly=RezepteMaui"
             xmlns:vm="clr-namespace:Rezepte.ViewModels;assembly=RezepteMaui"
             x:Class="Rezepte.Views.ReceiptCardPage"
             Title="{Binding Title}"
             x:DataType="vm:ReceiptCardViewModel">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollView  
            Grid.Column="0">
            <VerticalStackLayout>
                <Image        
                    HeightRequest="400"
                    WidthRequest="400"
                    VerticalOptions="Start"
                    Source="{Binding Picture}"> 
                </Image>

                <ListView ItemsSource="{Binding Ingredients.Ingredients}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ReceiptIngredient">
                            <ViewCell>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Label 
                                        Grid.Column="0" 
                                        HorizontalOptions="End" 
                                        Margin="10, 0"
                                        Text="{Binding Quantity}"/>
                                    <Label 
                                        Grid.Column="1" 
                                        HorizontalOptions="Start" 
                                        Margin="10, 0"
                                        Text="{Binding Name}"/>                                    
                                </Grid>
                            </ViewCell>
                            
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </VerticalStackLayout>
        </ScrollView>


        <ScrollView  
            Grid.Column="1">
            <VerticalStackLayout
                Margin="10,0">
                <Label                 
                    Text="{Binding Title}"
                    FontSize="Header"
                    VerticalOptions="Start" 
                    HorizontalOptions="Start" />

                <Label Text="{Binding Instructions}"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>