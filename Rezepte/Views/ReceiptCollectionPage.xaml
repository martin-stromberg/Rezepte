<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Rezepte.Views.ReceiptCollectionPage"
             xmlns:models="clr-namespace:Rezepte.Models;assembly=RezepteMaui"
             xmlns:vm="clr-namespace:Rezepte.ViewModels;assembly=RezepteMaui"
             xmlns:view="clr-namespace:Rezepte.Views"
             x:DataType="vm:ReceiptCollectionViewModel"
             NavigationPage.BackButtonTitle="Back"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+📝" Command="{Binding MenuAction}" CommandParameter="addReceipt"/>
        <ToolbarItem Text="X📚" Command="{Binding MenuAction}" CommandParameter="removeCategory"/>
    </ContentPage.ToolbarItems>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        

        <ScrollView Grid.Row="0">
            <VerticalStackLayout>                
                <FlexLayout
                    AlignContent="Start"
                    AlignItems="Start"
                    AlignSelf="Start"
                    BindableLayout.ItemsSource="{Binding Items}"
                    Direction="Row"
                    JustifyContent="Start"
                    Wrap="Wrap">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReceiptListItemViewModel">
                            <view:ReceiptListItemView BindingContext="{Binding .}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        
        <HorizontalStackLayout 
            Grid.Row="0"
            HorizontalOptions="End" 
            VerticalOptions="Start"
            IsVisible="{Binding IsAddingMode}">
            <Editor Text="{Binding NewReceiptUri}" />
            <Button Text="+" Command="{Binding MenuAction}" CommandParameter="addURI"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>