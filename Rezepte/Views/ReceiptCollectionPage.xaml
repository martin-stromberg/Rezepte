<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Rezepte.Views.ReceiptCollectionPage"
             xmlns:models="clr-namespace:Rezepte.Models;assembly=RezepteMaui"
             xmlns:vm="clr-namespace:Rezepte.ViewModels;assembly=RezepteMaui"
             xmlns:view="clr-namespace:Rezepte.Views"
             x:DataType="vm:ReceiptCollectionViewModel"
             Title="{Binding Title}">
    <ScrollView>


        <VerticalStackLayout>
            <FlexLayout
                AlignContent="Start"
                AlignItems="Start"
                AlignSelf="Start"
                BindableLayout.ItemsSource="{Binding Items}"
                Direction="Row"
                JustifyContent="Start"
                Wrap="Wrap">        
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReceiptListItemViewModel">
                        <view:ReceiptListItemView BindingContext="{Binding .}"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>