root = true

# Line endings are normalized to LF via .gitattributes (eol=lf); pin the same
# here so `dotnet format` produces/verifies LF on every platform (Windows
# would otherwise default to CRLF and fail verification on LF checkouts).
[*]
end_of_line = lf

# xunit.v3 suggestion introduced with the 4.x analyzer package; adopting
# TestContext.Current.CancellationToken across the suite is tracked separately
# from the .NET 11 platform migration.
[*.cs]
dotnet_diagnostic.xUnit1051.severity = suggestion
